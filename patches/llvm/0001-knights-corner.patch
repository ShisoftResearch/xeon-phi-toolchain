+// Run before type legalization: KNC's conversion instructions consume/produce
+// eight low FP32 lanes in a 512-bit register. Keep the machine-node interface
+// entirely in legal full-width types while splitting larger vectors and padding
+// smaller ones. Integer bitcasts preserve the exact lane layout across soft FP.
+// Bridge legal f80 to soft-float f32/f64 without softening an FP_EXTEND
+// operand. The x87 memory forms perform the format conversion; integer slots
+// transport only the source/result bits and do not change the scalar ABI.
+static SDValue lowerKNCX87FormatConversion(SDNode *N, SelectionDAG &DAG) {
+  unsigned Opcode = N->getOpcode();
+  bool Strict = N->isStrictFPOpcode();
+  bool Extend = Opcode == ISD::FP_EXTEND || Opcode == ISD::STRICT_FP_EXTEND;
+  bool Round = Opcode == ISD::FP_ROUND || Opcode == ISD::STRICT_FP_ROUND;
+  if (!Extend && !Round)
+    return SDValue();
+  SDValue Input = N->getOperand(Strict ? 1 : 0);
+  EVT ResultVT = N->getValueType(0), InputVT = Input.getValueType();
+  EVT MemoryVT = Extend ? InputVT : ResultVT;
+  if ((Extend ? ResultVT : InputVT) != MVT::f80 ||
+      (MemoryVT != MVT::f32 && MemoryVT != MVT::f64))
+    return SDValue();
+  SDLoc DL(N);
+  EVT IntVT = MemoryVT == MVT::f32 ? MVT::i32 : MVT::i64;
+  SDValue Slot = DAG.CreateStackTemporary(IntVT);
+  auto MPI = MachinePointerInfo::getFixedStack(DAG.getMachineFunction(),
+      cast<FrameIndexSDNode>(Slot)->getIndex());
+  Align Alignment = DAG.getEVTAlign(IntVT);
+  SDValue Chain = Strict ? N->getOperand(0) : DAG.getEntryNode();
+  if (Extend) {
+    Chain = DAG.getStore(Chain, DL, DAG.getBitcast(IntVT, Input), Slot, MPI,
+                         Alignment);
+    SDValue Load = DAG.getMemIntrinsicNode(X86ISD::FLD, DL,
+        DAG.getVTList(MVT::f80, MVT::Other), {Chain, Slot}, MemoryVT, MPI,
+        Alignment, MachineMemOperand::MOLoad);
+    return Strict ? DAG.getMergeValues({Load, Load.getValue(1)}, DL) : Load;
+  }
+  Chain = DAG.getMemIntrinsicNode(X86ISD::FST, DL, DAG.getVTList(MVT::Other),
+      {Chain, Input, Slot}, MemoryVT, MPI, Alignment,
+      MachineMemOperand::MOStore);
+  SDValue Load = DAG.getLoad(IntVT, DL, Chain, Slot, MPI, Alignment);
+  SDValue Result = DAG.getBitcast(ResultVT, Load);
+  return Strict ? DAG.getMergeValues({Result, Load.getValue(1)}, DL) : Result;
+}
