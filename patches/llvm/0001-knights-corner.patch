 /// Provide custom lowering hooks for some operations.
+// KNC vector operations use their own instructions, never SSE/AVX encodings.
+static SDValue kncI32Vector(ArrayRef<unsigned> Values, const SDLoc &DL,
+                             SelectionDAG &DAG) {
+  SmallVector<SDValue, 16> Lanes;
+  for (unsigned V : Values) Lanes.push_back(DAG.getConstant(V, DL, MVT::i32));
+  return DAG.getBuildVector(MVT::v16i32, DL, Lanes);
+}
+
+static SDValue kncCompareMask(SDValue A, SDValue B, ISD::CondCode CC,
+                              const SDLoc &DL, SelectionDAG &DAG) {
+  unsigned Pred;
+  bool Unsigned = false;
+  switch (CC) {
+  case ISD::SETEQ: Pred = 0; break;
+  case ISD::SETNE: Pred = 4; break;
+  case ISD::SETLT: Pred = 1; break;
+  case ISD::SETLE: Pred = 2; break;
+  case ISD::SETGE: Pred = 5; break;
+  case ISD::SETGT: Pred = 6; break;
+  case ISD::SETULT: Pred = 1; Unsigned = true; break;
+  case ISD::SETULE: Pred = 2; Unsigned = true; break;
+  case ISD::SETUGE: Pred = 5; Unsigned = true; break;
+  case ISD::SETUGT: Pred = 6; Unsigned = true; break;
+  default: return SDValue();
+  }
+  return SDValue(DAG.getMachineNode(Unsigned ? X86::KNC_CMP_U32 : X86::KNC_CMP_I32,
+      DL, MVT::i32, A, B, DAG.getTargetConstant(Pred, DL, MVT::i32)), 0);
+}
+
+
+// KNC's integer ALU works on dwords. Keep eight i64 values in a VR512
+// register and emulate each operation with adjacent low/high dword pairs.
+static SDValue kncWordSplat(uint32_t V, const SDLoc &DL, SelectionDAG &DAG) {
+  return kncI32Vector(SmallVector<unsigned, 16>(16, V), DL, DAG);
+}
+static SDValue kncWordPermute(SDValue V, ArrayRef<unsigned> Indices,
+                              const SDLoc &DL, SelectionDAG &DAG) {
+  return SDValue(DAG.getMachineNode(X86::KNC_VPERMDrr, DL, MVT::v16i32,
+      kncI32Vector(Indices, DL, DAG), DAG.getBitcast(MVT::v16i32, V)), 0);
+}
+// Return the reduction in every dword lane. Scalar consumers may extract
+// lane zero, while a following FP conversion can keep the register directly.
+static SDValue kncReduceI32Vector(unsigned Binary, SDValue V,
+                                  const SDLoc &DL, SelectionDAG &DAG) {
+  for (unsigned Step : {8u, 4u, 2u, 1u}) {
+    SmallVector<unsigned, 16> Indices;
+    for (unsigned I = 0; I != 16; ++I)
+      Indices.push_back(I ^ Step);
+    V = DAG.getNode(Binary, DL, MVT::v16i32, V,
+                     kncWordPermute(V, Indices, DL, DAG));
+  }
+  return V;
+}
+
+static SDValue kncHalfWords(SDValue V, unsigned Half, const SDLoc &DL,
+                            SelectionDAG &DAG) {
+  SmallVector<unsigned, 16> Indices;
+  for (unsigned I = 0; I != 16; ++I) Indices.push_back((I & ~1u) + Half);
+  return kncWordPermute(V, Indices, DL, DAG);
+}
+static SDValue kncWordBlend(SDValue A, SDValue B, SDValue Mask,
+                            const SDLoc &DL, SelectionDAG &DAG) {
+  return SDValue(DAG.getMachineNode(X86::KNC_BLEND_I32, DL, MVT::v16i32,
+                                   A, B, Mask), 0);
+}
+static SDValue kncWordCond(SDValue A, SDValue B, ISD::CondCode CC,
+                           const SDLoc &DL, SelectionDAG &DAG) {
+  return kncWordBlend(kncWordSplat(0, DL, DAG), kncWordSplat(~0u, DL, DAG),
+                      kncCompareMask(A, B, CC, DL, DAG), DL, DAG);
+}
+static SDValue kncCompareI64(SDValue A, SDValue B, ISD::CondCode CC,
+                             const SDLoc &DL, SelectionDAG &DAG) {
+  SDValue AL = kncHalfWords(A, 0, DL, DAG), AH = kncHalfWords(A, 1, DL, DAG);
+  SDValue BL = kncHalfWords(B, 0, DL, DAG), BH = kncHalfWords(B, 1, DL, DAG);
+  auto Bin = [&](unsigned Op, SDValue X, SDValue Y) {
+    return DAG.getNode(Op, DL, MVT::v16i32, X, Y);
+  };
+  SDValue EqH = kncWordCond(AH, BH, ISD::SETEQ, DL, DAG);
+  SDValue Eq = Bin(ISD::AND, EqH, kncWordCond(AL, BL, ISD::SETEQ, DL, DAG));
+  bool Unsigned = CC == ISD::SETULT || CC == ISD::SETULE ||
+                  CC == ISD::SETUGT || CC == ISD::SETUGE;
+  SDValue LT = Bin(ISD::OR, kncWordCond(AH, BH, Unsigned ? ISD::SETULT : ISD::SETLT, DL, DAG),
+      Bin(ISD::AND, EqH, kncWordCond(AL, BL, ISD::SETULT, DL, DAG)));
+  auto Not = [&](SDValue V) { return Bin(ISD::XOR, V, kncWordSplat(~0u, DL, DAG)); };
+  switch (CC) {
+  case ISD::SETEQ: return Eq;
+  case ISD::SETNE: return Not(Eq);
+  case ISD::SETLT: case ISD::SETULT: return LT;
+  case ISD::SETLE: case ISD::SETULE: return Bin(ISD::OR, LT, Eq);
+  case ISD::SETGT: case ISD::SETUGT: return Not(Bin(ISD::OR, LT, Eq));
+  case ISD::SETGE: case ISD::SETUGE: return Not(LT);
+  default: return SDValue();
+  }
+}
+static SDValue kncI64Binary(unsigned Opcode, SDValue A, SDValue B,
+                             const SDLoc &DL, SelectionDAG &DAG) {
+  if (Opcode != ISD::ADD && Opcode != ISD::SUB && Opcode != ISD::MUL &&
+      Opcode != ISD::AND && Opcode != ISD::OR && Opcode != ISD::XOR &&
+      Opcode != ISD::SHL && Opcode != ISD::SRL && Opcode != ISD::SRA &&
+      Opcode != ISD::UMIN && Opcode != ISD::UMAX && Opcode != ISD::SMIN && Opcode != ISD::SMAX)
+    return SDValue();
+  SDValue X = DAG.getBitcast(MVT::v16i32, A), Y = DAG.getBitcast(MVT::v16i32, B);
+  auto Bin = [&](unsigned Op, SDValue U, SDValue V) { return DAG.getNode(Op, DL, MVT::v16i32, U, V); };
+  if (Opcode == ISD::AND || Opcode == ISD::OR || Opcode == ISD::XOR)
+    return DAG.getBitcast(MVT::v8i64, Bin(Opcode, X, Y));
+  SDValue AL = kncHalfWords(X, 0, DL, DAG), AH = kncHalfWords(X, 1, DL, DAG);
+  SDValue BL = kncHalfWords(Y, 0, DL, DAG), BH = kncHalfWords(Y, 1, DL, DAG);
+  SDValue Lo, Hi;
+  if (Opcode == ISD::ADD || Opcode == ISD::SUB) {
+    Lo = Bin(Opcode, AL, BL);
+    SDValue Carry = kncWordCond(Opcode == ISD::ADD ? Lo : AL,
+                               Opcode == ISD::ADD ? AL : BL, ISD::SETULT, DL, DAG);
+    Carry = Bin(ISD::AND, Carry, kncWordSplat(1, DL, DAG));
+    Hi = Bin(Opcode, Bin(Opcode, AH, BH), Carry);
+  } else if (Opcode == ISD::MUL) {
+    Lo = Bin(ISD::MUL, AL, BL);
+    SDValue HighProduct(DAG.getMachineNode(X86::KNC_VPMULHUDrr, DL, MVT::v16i32, AL, BL), 0);
+    Hi = Bin(ISD::ADD, HighProduct, Bin(ISD::ADD, Bin(ISD::MUL, AL, BH), Bin(ISD::MUL, AH, BL)));
+  } else if (Opcode == ISD::SHL || Opcode == ISD::SRL || Opcode == ISD::SRA) {
+    SDValue Count = Bin(ISD::AND, BL, kncWordSplat(63, DL, DAG));
+    SDValue Inv = Bin(ISD::SUB, kncWordSplat(32, DL, DAG), Count);
+    SDValue Over = Bin(ISD::SUB, Count, kncWordSplat(32, DL, DAG));
+    auto Shift = [&](unsigned Op, SDValue V, SDValue C) {
+      unsigned MC = Op == ISD::SHL ? X86::KNC_VPSLLVDrr :
+                    Op == ISD::SRL ? X86::KNC_VPSRLVDrr : X86::KNC_VPSRAVDrr;
+      // Machine shifts define counts >=32, unlike LLVM dword shift poison.
+      return SDValue(DAG.getMachineNode(MC, DL, MVT::v16i32, V, C), 0);
+    };
+    if (Opcode == ISD::SHL) {
+      Lo = Shift(ISD::SHL, AL, Count);
+      Hi = Bin(ISD::OR, Shift(ISD::SHL, AH, Count),
+          Bin(ISD::OR, Shift(ISD::SRL, AL, Inv), Shift(ISD::SHL, AL, Over)));
+    } else if (Opcode == ISD::SRL) {
+      Hi = Shift(ISD::SRL, AH, Count);
+      Lo = Bin(ISD::OR, Shift(ISD::SRL, AL, Count),
+          Bin(ISD::OR, Shift(ISD::SHL, AH, Inv), Shift(ISD::SRL, AH, Over)));
+    } else {
+      Hi = Shift(ISD::SRA, AH, Count);
+      SDValue Small = Bin(ISD::OR, Shift(ISD::SRL, AL, Count), Shift(ISD::SHL, AH, Inv));
+      SDValue Big = Shift(ISD::SRA, AH, Over);
+      Lo = kncWordBlend(Big, Small, kncCompareMask(Count, kncWordSplat(32, DL, DAG),
+                             ISD::SETULT, DL, DAG), DL, DAG);
+    }
+  } else if (Opcode == ISD::UMIN || Opcode == ISD::UMAX ||
+             Opcode == ISD::SMIN || Opcode == ISD::SMAX) {
+    bool Min = Opcode == ISD::UMIN || Opcode == ISD::SMIN;
+    bool Unsigned = Opcode == ISD::UMIN || Opcode == ISD::UMAX;
+    SDValue Cond = kncCompareI64(A, B, Unsigned ? ISD::SETULT : ISD::SETLT, DL, DAG);
+    SDValue Mask = kncCompareMask(Cond, kncWordSplat(0, DL, DAG), ISD::SETNE, DL, DAG);
+    return DAG.getBitcast(MVT::v8i64, kncWordBlend(Min ? Y : X, Min ? X : Y, Mask, DL, DAG));
+  } else return SDValue();
+  return DAG.getBitcast(MVT::v8i64, kncWordBlend(Lo, Hi,
+                               DAG.getConstant(0xaaaa, DL, MVT::i32), DL, DAG));
+}
+
+
+// Keep integer comparison masks in a GPR rather than materializing a vector
+// of all-ones lanes and immediately comparing it back to zero.
+static SDValue kncScalarMask(SDValue Mask, unsigned Lanes, const SDLoc &DL,
+                             SelectionDAG &DAG) {
+  if (Lanes == 16) {
+    if (Mask.getOpcode() == ISD::SETCC && Mask.getOperand(0).getValueType() == MVT::v16i32)
+      if (SDValue M = kncCompareMask(Mask.getOperand(0), Mask.getOperand(1),
+          cast<CondCodeSDNode>(Mask.getOperand(2))->get(), DL, DAG))
+        return M;
+    if ((Mask.getOpcode() == ISD::AND || Mask.getOpcode() == ISD::OR || Mask.getOpcode() == ISD::XOR) &&
+        Mask.getValueType() == MVT::v16i1)
+      return DAG.getNode(Mask.getOpcode(), DL, MVT::i32,
+          kncScalarMask(Mask.getOperand(0), 16, DL, DAG),
+          kncScalarMask(Mask.getOperand(1), 16, DL, DAG));
+    SDValue Wide = DAG.getSExtOrTrunc(Mask, DL, MVT::v16i32);
+    return kncCompareMask(Wide, kncWordSplat(0, DL, DAG), ISD::SETNE, DL, DAG);
+  }
+  SDValue Result = DAG.getConstant(0, DL, MVT::i32);
+  for (unsigned I = 0; I != Lanes; ++I) {
+    SDValue Bit = DAG.getNode(ISD::EXTRACT_VECTOR_ELT, DL, MVT::i1,
+                              Mask, DAG.getVectorIdxConstant(I, DL));
+    Bit = DAG.getNode(ISD::ZERO_EXTEND, DL, MVT::i32, Bit);
+    Bit = DAG.getNode(ISD::SHL, DL, MVT::i32, Bit, DAG.getConstant(I, DL, MVT::i8));
+    Result = DAG.getNode(ISD::OR, DL, MVT::i32, Result, Bit);
+  }
+  return Result;
+}
+
+// A native scatter may visit lanes in any order. Distinct constant element
+// offsets, together with scale four and four-byte stores, prove disjointness.
+// Do not infer this from a runtime index vector or from an inactive-mask guess.
+static bool kncHasDistinctConstantIndices(SDValue Index) {
+  if (Index.getScalarValueSizeInBits() > 64 ||
+      Index.getOpcode() != ISD::BUILD_VECTOR)
+    return false;
+  SmallSet<uint64_t, 16> Offsets;
+  for (const SDValue &Lane : Index->ops()) {
+    auto *C = dyn_cast<ConstantSDNode>(Lane);
+    if (!C || !Offsets.insert(C->getZExtValue()).second)
+      return false;
+  }
+  return true;
+}
+
+// Lower before type legalization: a generic pointer vector may contain full
+// 64-bit addresses, while IMCI only accepts signed 32-bit element offsets.
+static SDValue lowerKNCMaskedGatherScatter(SDNode *N, SelectionDAG &DAG,
+                                          bool Contiguous = false) {
+  auto *Mem = cast<MaskedGatherScatterSDNode>(N);
+  bool Gather = N->getOpcode() == ISD::MGATHER;
+  SDValue Data = N->getOperand(1);
+  EVT VT = Data.getValueType();
+  if (!VT.isFixedLengthVector() || Mem->getMemoryVT() != VT)
+    return SDValue();
+  unsigned Lanes = VT.getVectorNumElements();
+  unsigned Bits = VT.getScalarSizeInBits();
+  if ((Lanes != 2 && Lanes != 4 && Lanes != 8 && Lanes != 16) ||
+      (Bits != 8 && Bits != 16 && Bits != 32 && Bits != 64) ||
+      (!VT.isInteger() && VT.getVectorElementType() != MVT::f32 &&
+       VT.getVectorElementType() != MVT::f64))
+    return SDValue();
+  // Never silently discard FS/GS or other non-flat address-space semantics.
+  if (Mem->getAddressSpace() != 0)
+    report_fatal_error("KNC masked gather/scatter requires address space zero");
+  SDLoc DL(N);
+  SDValue Index = Mem->getIndex();
+  SDValue Mask = kncScalarMask(Mem->getMask(), Lanes, DL, DAG);
+  SDValue Chain = Mem->getChain();
+  EVT IntVT = EVT::getVectorVT(*DAG.getContext(),
+                               EVT::getIntegerVT(*DAG.getContext(), Bits), Lanes);
+  SDValue IntData = DAG.getBitcast(IntVT, Data);
+
+  // IMCI gathers/scatters have sixteen signed-i32 offsets. Smaller i32/FP32
+  // operations pad to sixteen lanes, with every added mask bit clear. Stores
+  // need an explicit disjointness proof; uncertain/conflicting stores retain
+  // the ordered exact-width scalar fallback.
+  bool NativeIndex =
+      (Mem->isIndexSigned() && Index.getScalarValueSizeInBits() == 32) ||
+      (Index.getScalarValueSizeInBits() == 64 && DAG.ComputeNumSignBits(Index) > 32);
+  // Measured setup/padding costs do not consistently benefit two/four lanes.
+  // Keep those generic stores on the existing ordered path.
+  bool Disjoint = Contiguous ||
+                  (KNCDisjointScatter && Lanes >= 8 &&
+                   kncHasDistinctConstantIndices(Index));
+  if ((Gather || Disjoint) && Bits == 32 && NativeIndex &&
+      Mem->getScale()->getAsZExtVal() == 4 && Mem->getBaseAlign() >= Align(4)) {
+    SDValue WideIndex, WideData;
+    if (Lanes == 16) {
+      WideIndex = DAG.getZExtOrTrunc(Index, DL, MVT::v16i32);
+      WideData = IntData;
+    } else {
+      SmallVector<SDValue, 16> Indices, Values;
+      for (unsigned I = 0; I != 16; ++I) {
+        if (I >= Lanes) {
+          Indices.push_back(DAG.getConstant(0, DL, MVT::i32));
+          Values.push_back(DAG.getConstant(0, DL, MVT::i32));
+          continue;
+        }
+        SDValue Lane = DAG.getNode(ISD::EXTRACT_VECTOR_ELT, DL,
+            Index.getValueType().getVectorElementType(), Index,
+            DAG.getVectorIdxConstant(I, DL));
+        Indices.push_back(DAG.getZExtOrTrunc(Lane, DL, MVT::i32));
+        Values.push_back(DAG.getNode(ISD::EXTRACT_VECTOR_ELT, DL, MVT::i32,
+                                     IntData, DAG.getVectorIdxConstant(I, DL)));
+      }
+      WideIndex = DAG.getBuildVector(MVT::v16i32, DL, Indices);
+      WideData = DAG.getBuildVector(MVT::v16i32, DL, Values);
+    }
+    if (!Gather) {
+      auto *Store = DAG.getMachineNode(X86::KNC_SCATTER_I32, DL,
+          DAG.getVTList(MVT::Other),
+          {Mem->getBasePtr(), WideIndex, WideData, Mask, Chain});
+      DAG.setNodeMemRefs(Store, {Mem->getMemOperand()});
+      return SDValue(Store, 0);
+    }
+    auto *Load = DAG.getMachineNode(X86::KNC_GATHER_I32, DL,
+        DAG.getVTList(MVT::v16i32, MVT::Other),
+        {Mem->getBasePtr(), WideIndex, WideData, Mask, Chain});
+    DAG.setNodeMemRefs(Load, {Mem->getMemOperand()});
+    SDValue Result(Load, 0);
+    if (Lanes != 16)
+      Result = DAG.getNode(ISD::EXTRACT_SUBVECTOR, DL, IntVT, Result,
+                            DAG.getVectorIdxConstant(0, DL));
+    return DAG.getMergeValues({DAG.getBitcast(VT, Result), SDValue(Load, 1)}, DL);
+  }
+
+  // The fallback uses full pointers and exact-width scalar accesses. Visiting
+  // active lanes from low to high preserves even partially overlapping stores.
+  EVT AddressVT = EVT::getVectorVT(*DAG.getContext(), MVT::i64, Lanes);
+  SDValue Addresses = DAG.CreateStackTemporary(AddressVT);
+  SDValue Values = DAG.CreateStackTemporary(VT);
+  SmallVector<SDValue, 17> Stores;
+  for (unsigned I = 0; I != Lanes; ++I) {
+    SDValue Lane = DAG.getNode(ISD::EXTRACT_VECTOR_ELT, DL,
+        Index.getValueType().getVectorElementType(), Index,
+        DAG.getVectorIdxConstant(I, DL));
+    Lane = Mem->isIndexSigned() ? DAG.getSExtOrTrunc(Lane, DL, MVT::i64)
+                               : DAG.getZExtOrTrunc(Lane, DL, MVT::i64);
+    Lane = DAG.getNode(ISD::MUL, DL, MVT::i64, Lane,
+        DAG.getConstant(Mem->getScale()->getAsZExtVal(), DL, MVT::i64));
+    SDValue Address = DAG.getNode(ISD::ADD, DL, MVT::i64, Mem->getBasePtr(), Lane);
+    SDValue Slot = DAG.getMemBasePlusOffset(Addresses, TypeSize::getFixed(I * 8), DL);
+    Stores.push_back(DAG.getStore(Chain, DL, Address, Slot,
+                                 MachinePointerInfo(), Align(8)));
+  }
+  Stores.push_back(DAG.getStore(Chain, DL, Data, Values,
+                               MachinePointerInfo(), DAG.getEVTAlign(VT)));
+  Chain = DAG.getNode(ISD::TokenFactor, DL, MVT::Other, Stores);
+  auto *Access = DAG.getMachineNode(Gather ? X86::KNC_MASKED_GATHER_SCALAR
+                                         : X86::KNC_MASKED_SCATTER_SCALAR,
+      DL, DAG.getVTList(MVT::Other),
+      {Addresses, Values, Mask, DAG.getTargetConstant(Bits / 8, DL, MVT::i32), Chain});
+  DAG.setNodeMemRefs(Access, {Mem->getMemOperand()});
+  Chain = SDValue(Access, 0);
+  if (!Gather)
+    return Chain;
+  SDValue Result = DAG.getLoad(VT, DL, Chain, Values,
+                               MachinePointerInfo(), DAG.getEVTAlign(VT));
+  return DAG.getMergeValues({Result, Result.getValue(1)}, DL);
+}
+
+// Reuse the fault-suppressing gather/scatter paths with fixed contiguous indices.
+// Lower before type legalization, preserving the original memory operand/chain.
+static SDValue lowerKNCMaskedLoadStore(SDNode *N, SelectionDAG &DAG) {
+  auto *Mem = cast<MaskedLoadStoreSDNode>(N);
+  if (!Mem->isUnindexed())
+    return SDValue();
+  bool Load = N->getOpcode() == ISD::MLOAD;
+  SDValue Data, Base;
+  ISD::LoadExtType Ext = ISD::NON_EXTLOAD;
+  bool Packed = false;
+  if (Load) {
+    auto *L = cast<MaskedLoadSDNode>(N);
+    Packed = L->isExpandingLoad();
+    Data = L->getPassThru();
+    Base = L->getBasePtr();
+    Ext = L->getExtensionType();
+  } else {
+    auto *S = cast<MaskedStoreSDNode>(N);
+    Packed = S->isCompressingStore();
+    Data = S->getValue();
+    Base = S->getBasePtr();
+  }
+  EVT VT = Data.getValueType(), MemVT = Mem->getMemoryVT();
+  if (!VT.isFixedLengthVector() || !MemVT.isFixedLengthVector())
+    return SDValue();
+  SDLoc DL(N);
+  if (VT != MemVT) {
+    // Integer extending loads restore inactive lanes from the original wider
+    // passthrough after extension. Truncating stores narrow before accessing
+    // memory, so inactive or boundary lanes never cause a wider access.
+    if (!VT.isInteger() || !MemVT.isInteger() ||
+        VT.getVectorNumElements() != MemVT.getVectorNumElements() ||
+        VT.getScalarSizeInBits() <= MemVT.getScalarSizeInBits())
+      return SDValue();
+    Data = DAG.getNode(ISD::TRUNCATE, DL, MemVT, Data);
+  }
+  unsigned Lanes = MemVT.getVectorNumElements();
+  SmallVector<SDValue, 16> Indices;
+  EVT IndexVT = EVT::getVectorVT(*DAG.getContext(), MVT::i32, Lanes);
+  SDValue Index;
+  if (Packed && Lanes == 16 && MemVT.getScalarSizeInBits() == 32 && Mem->getBaseAlign() >= Align(4)) {
+    // SIMD exclusive prefix sum of mask bits supplies packed element indices.
+    SDValue Bits = kncScalarMask(Mem->getMask(), 16, DL, DAG);
+    SDValue Broadcast = DAG.getBuildVector(MVT::v16i32, DL, SmallVector<SDValue, 16>(16, Bits));
+    SmallVector<unsigned, 16> Powers;
+    for (unsigned I = 0; I != 16; ++I) Powers.push_back(1u << I);
+    SDValue Active = DAG.getNode(ISD::AND, DL, MVT::v16i32, Broadcast, kncI32Vector(Powers, DL, DAG));
+    Active = DAG.getNode(ISD::AND, DL, MVT::v16i32,
+        kncWordCond(Active, kncWordSplat(0, DL, DAG), ISD::SETNE, DL, DAG), kncWordSplat(1, DL, DAG));
+    SDValue Sum = Active;
+    for (unsigned Step : {1u, 2u, 4u, 8u}) {
+      SmallVector<unsigned, 16> Shift;
+      for (unsigned I = 0; I != 16; ++I) Shift.push_back(I >= Step ? I - Step : 0);
+      SDValue Prev = kncWordPermute(Sum, Shift, DL, DAG);
+      Prev = kncWordBlend(kncWordSplat(0, DL, DAG), Prev,
+          DAG.getConstant((0xffffu << Step) & 0xffffu, DL, MVT::i32), DL, DAG);
+      Sum = DAG.getNode(ISD::ADD, DL, MVT::v16i32, Sum, Prev);
+    }
+    Index = DAG.getNode(ISD::SUB, DL, MVT::v16i32, Sum, Active);
+  } else {
+    SDValue Rank = DAG.getConstant(0, DL, MVT::i32);
+    SDValue Bits = Packed ? kncScalarMask(Mem->getMask(), Lanes, DL, DAG) : SDValue();
+    for (unsigned I = 0; I != Lanes; ++I) {
+      Indices.push_back(Packed ? Rank : DAG.getConstant(I, DL, MVT::i32));
+      if (Packed) {
+        SDValue Bit = DAG.getNode(ISD::SRL, DL, MVT::i32, Bits, DAG.getConstant(I, DL, MVT::i8));
+        Bit = DAG.getNode(ISD::AND, DL, MVT::i32, Bit, DAG.getConstant(1, DL, MVT::i32));
+        Rank = DAG.getNode(ISD::ADD, DL, MVT::i32, Rank, Bit);
+      }
+    }
+    Index = DAG.getBuildVector(IndexVT, DL, Indices);
+  }
+  SDValue Scale = DAG.getTargetConstant(MemVT.getScalarStoreSize(), DL, MVT::i64);
+  SDValue Ops[] = {Mem->getChain(), Data, Mem->getMask(), Base, Index, Scale};
+  SDValue Access = Load ? DAG.getMaskedGather(DAG.getVTList(MemVT, MVT::Other),
+      MemVT, DL, Ops, Mem->getMemOperand(), ISD::SIGNED_SCALED, ISD::NON_EXTLOAD)
+      : DAG.getMaskedScatter(DAG.getVTList(MVT::Other), MemVT, DL, Ops,
+                            Mem->getMemOperand(), ISD::SIGNED_SCALED, false);
+  SDValue Result = lowerKNCMaskedGatherScatter(Access.getNode(), DAG, true);
+  if (!Result || !Load || VT == MemVT)
+    return Result;
+  SDValue Extended = DAG.getNode(Ext == ISD::SEXTLOAD ? ISD::SIGN_EXTEND
+                                                    : ISD::ZERO_EXTEND,
+                                 DL, VT, Result);
+  Extended = DAG.getNode(ISD::VSELECT, DL, VT, Mem->getMask(), Extended,
+                          cast<MaskedLoadSDNode>(N)->getPassThru());
+  return DAG.getMergeValues({Extended, Result.getValue(1)}, DL);
+}
+
+// KNC implements only the original eight comparison predicates. The later
+// AVX predicates (immediates 8..31) trap on real KNC hardware. Construct the
+// remaining LLVM relations using operand reversal and scalar mask logic.
+static SDValue kncCompareFP(SDValue A, SDValue B, ISD::CondCode CC,
+                            const SDLoc &DL, SelectionDAG &DAG) {
+  unsigned Opc = A.getValueType() == MVT::v8f64 ? X86::KNC_CMP_F64 : X86::KNC_CMP_F32;
+  auto Emit = [&](SDValue X, SDValue Y, unsigned Pred) {
+    return SDValue(DAG.getMachineNode(Opc, DL, MVT::i32,
+        DAG.getBitcast(MVT::v16i32, X), DAG.getBitcast(MVT::v16i32, Y),
+        DAG.getTargetConstant(Pred, DL, MVT::i32)), 0);
+  };
+  switch (CC) {
+  case ISD::SETFALSE: return DAG.getConstant(0, DL, MVT::i32);
+  case ISD::SETTRUE: return DAG.getConstant(A.getValueType() == MVT::v8f64 ? 255 : 65535, DL, MVT::i32);
+  case ISD::SETOEQ: case ISD::SETEQ: return Emit(A, B, 0);
+  case ISD::SETOGT: case ISD::SETGT: return Emit(B, A, 1);
+  case ISD::SETOGE: case ISD::SETGE: return Emit(B, A, 2);
+  case ISD::SETOLT: case ISD::SETLT: return Emit(A, B, 1);
+  case ISD::SETOLE: case ISD::SETLE: return Emit(A, B, 2);
+  case ISD::SETONE:
+    return DAG.getNode(ISD::AND, DL, MVT::i32, Emit(A, B, 4), Emit(A, B, 7));
+  case ISD::SETO: return Emit(A, B, 7);
+  case ISD::SETUO: return Emit(A, B, 3);
+  case ISD::SETUEQ:
+    return DAG.getNode(ISD::OR, DL, MVT::i32, Emit(A, B, 0), Emit(A, B, 3));
+  case ISD::SETUGT: return Emit(A, B, 6);
+  case ISD::SETUGE: return Emit(A, B, 5);
+  case ISD::SETULT: return Emit(B, A, 6);
+  case ISD::SETULE: return Emit(B, A, 5);
+  case ISD::SETUNE: case ISD::SETNE: return Emit(A, B, 4);
+  default: return SDValue();
+  }
+}
+
+// The eight-bit FP64 mask selects complete qwords, including both dwords.
+static SDValue kncFPBlend(EVT VT, SDValue A, SDValue B, SDValue Mask,
+                          const SDLoc &DL, SelectionDAG &DAG) {
+  unsigned Opc = VT == MVT::v8f64 ? X86::KNC_BLEND_F64 : X86::KNC_BLEND_I32;
+  return SDValue(DAG.getMachineNode(Opc, DL, MVT::v16i32,
+      DAG.getBitcast(MVT::v16i32, A), DAG.getBitcast(MVT::v16i32, B), Mask), 0);
+}
+
+static SDValue kncFPBits(EVT VT, uint64_t Bits, const SDLoc &DL,
+                         SelectionDAG &DAG) {
+  SmallVector<unsigned, 16> Words;
+  for (unsigned I = 0; I != 16; ++I)
+    Words.push_back(VT == MVT::v8f64 && (I & 1) ? Bits >> 32 : uint32_t(Bits));
+  return kncI32Vector(Words, DL, DAG);
+}
+
+static SDValue lowerKNCFP(SDValue Op, const SDLoc &DL, SelectionDAG &DAG) {
+  EVT VT = Op.getValueType();
+  unsigned Opcode = Op.getOpcode();
+  if (Opcode == ISD::SETCC) {
+    EVT InVT = Op.getOperand(0).getValueType();
+    if (InVT != MVT::v16f32 && InVT != MVT::v8f64)
+      return SDValue();
+    SDValue Mask = kncCompareFP(Op.getOperand(0), Op.getOperand(1),
+        cast<CondCodeSDNode>(Op.getOperand(2))->get(), DL, DAG);
+    if (!Mask)
+      return SDValue();
+    return DAG.getBitcast(VT, kncFPBlend(InVT, kncWordSplat(0, DL, DAG),
+        kncWordSplat(~0u, DL, DAG), Mask, DL, DAG));
+  }
+  if (VT != MVT::v16f32 && VT != MVT::v8f64)
+    return SDValue();
+  SDValue A = Op.getOperand(0);
+  bool Wide = VT == MVT::v8f64;
+  uint64_t Sign = Wide ? UINT64_C(0x8000000000000000) : UINT64_C(0x80000000);
+  if (Opcode == ISD::FABS || Opcode == ISD::FNEG) {
+    SDValue Mask = kncFPBits(VT, Opcode == ISD::FABS ? ~Sign : Sign, DL, DAG);
+    return DAG.getBitcast(VT, DAG.getNode(Opcode == ISD::FABS ? ISD::AND : ISD::XOR,
+        DL, MVT::v16i32, DAG.getBitcast(MVT::v16i32, A), Mask));
+  }
+  if (Opcode == ISD::VSELECT) {
+    SDValue Mask = kncCompareMask(DAG.getBitcast(MVT::v16i32, A),
+        kncWordSplat(0, DL, DAG), ISD::SETNE, DL, DAG);
+    return DAG.getBitcast(VT, kncWordBlend(DAG.getBitcast(MVT::v16i32, Op.getOperand(2)),
+        DAG.getBitcast(MVT::v16i32, Op.getOperand(1)), Mask, DL, DAG));
+  }
+  bool Minimum, Propagate = false, Number2019 = false, Pseudo = false;
+  switch (Opcode) {
+  case ISD::FMINNUM: Minimum = true; break;
+  case ISD::FMAXNUM: Minimum = false; break;
+  case ISD::FMINIMUM: Minimum = true; Propagate = true; break;
+  case ISD::FMAXIMUM: Minimum = false; Propagate = true; break;
+  case ISD::FMINIMUMNUM: Minimum = true; Number2019 = true; break;
+  case ISD::FMAXIMUMNUM: Minimum = false; Number2019 = true; break;
+  case ISD::PSEUDO_FMIN: Minimum = true; Pseudo = true; break;
+  case ISD::PSEUDO_FMAX: Minimum = false; Pseudo = true; break;
+  default: return SDValue();
+  }
+  SDValue B = Op.getOperand(1);
+  SDValue Mask = kncCompareFP(A, B, Minimum ? ISD::SETOLT : ISD::SETOGT, DL, DAG);
+  SDValue Result = kncFPBlend(VT, B, A, Mask, DL, DAG);
+  if (Pseudo)
+    return DAG.getBitcast(VT, Result);
+  SDValue ABits = DAG.getBitcast(MVT::v16i32, A), BBits = DAG.getBitcast(MVT::v16i32, B);
+  SDValue Zero = kncWordSplat(0, DL, DAG);
+  SDValue ZeroFP = DAG.getBitcast(VT, Zero);
+  SDValue ZeroMask = DAG.getNode(ISD::AND, DL, MVT::i32,
+      kncCompareFP(A, ZeroFP, ISD::SETOEQ, DL, DAG),
+      kncCompareFP(B, ZeroFP, ISD::SETOEQ, DL, DAG));
+  // For a pair of zeros, OR selects -0 for minimum and AND selects +0 for maximum.
+  SDValue ZeroResult = DAG.getNode(Minimum ? ISD::OR : ISD::AND, DL, MVT::v16i32, ABits, BBits);
+  Result = kncFPBlend(VT, Result, ZeroResult, ZeroMask, DL, DAG);
+  SDValue ANaN = kncCompareFP(A, A, ISD::SETUO, DL, DAG);
+  SDValue BNaN = kncCompareFP(B, B, ISD::SETUO, DL, DAG);
+  SDValue NaNMask = DAG.getNode(Propagate ? ISD::OR : ISD::AND, DL, MVT::i32, ANaN, BNaN);
+  if (!Propagate)
+    Result = kncFPBlend(VT, Result, A, BNaN, DL, DAG);
+  SDValue QuietNaN = kncFPBits(VT, Wide ? UINT64_C(0x7ff8000000000000) : UINT64_C(0x7fc00000), DL, DAG);
+  Result = kncFPBlend(VT, Result, QuietNaN, NaNMask, DL, DAG);
+  if (!Propagate && !Number2019) {
+    // LLVM minnum/maxnum propagate sNaNs, unlike minimumNumber/maximumNumber.
+    auto Signaling = [&](SDValue Bits, SDValue NaNMask) {
+      SDValue NaNWords = kncFPBlend(VT, Zero, kncWordSplat(~0u, DL, DAG), NaNMask, DL, DAG);
+      SDValue High = Wide ? kncHalfWords(Bits, 1, DL, DAG) : Bits;
+      SDValue Q = DAG.getNode(ISD::AND, DL, MVT::v16i32, High,
+          kncWordSplat(Wide ? 0x00080000 : 0x00400000, DL, DAG));
+      SDValue QuietClear = kncCompareMask(Q, Zero, ISD::SETEQ, DL, DAG);
+      return kncWordBlend(Zero, NaNWords, QuietClear, DL, DAG);
+    };
+    SDValue SNaN = DAG.getNode(ISD::OR, DL, MVT::v16i32,
+        Signaling(ABits, ANaN), Signaling(BBits, BNaN));
+    Result = kncWordBlend(Result, QuietNaN, kncCompareMask(SNaN, kncWordSplat(0, DL, DAG), ISD::SETNE, DL, DAG), DL, DAG);
+  }
+  return DAG.getBitcast(VT, Result);
+}
+
+// IMCI word up/down-conversion requires two-byte element alignment. Preserve
+// byte-unaligned IR accesses with exact-width scalar copies to aligned storage.
+static SDValue kncAlignWordLoad(LoadSDNode *L, SDValue &Chain,
+                               const SDLoc &DL, SelectionDAG &DAG) {
+  SDValue Base = L->getBasePtr();
+  if (L->getAlign() >= Align(2))
+    return Base;
+  SDValue Slot = DAG.CreateStackTemporary(MVT::v16i16, 64);
+  for (unsigned I = 0; I != 16; ++I) {
+    SDValue Src = DAG.getObjectPtrOffset(DL, Base, TypeSize::getFixed(2 * I));
+    SDValue Dst = DAG.getObjectPtrOffset(DL, Slot, TypeSize::getFixed(2 * I));
+    SDValue H = DAG.getLoad(MVT::i16, DL, Chain, Src,
+        L->getPointerInfo().getWithOffset(2 * I), Align(1),
+        L->getMemOperand()->getFlags());
+    Chain = DAG.getStore(H.getValue(1), DL, H, Dst,
+                         MachinePointerInfo(), Align(2));
+  }
+  return Slot;
+}
+
+static SDValue kncUnalignedWordStore(StoreSDNode *S, unsigned Opcode,
+                                    const SDLoc &DL, SelectionDAG &DAG,
+                                    SDValue Value) {
+  SDValue Slot = DAG.CreateStackTemporary(MVT::v16i16, 64);
+  SDValue Chain = SDValue(DAG.getMachineNode(Opcode, DL, MVT::Other,
+                                            Slot, Value, S->getChain()), 0);
+  for (unsigned I = 0; I != 16; ++I) {
+    SDValue Src = DAG.getObjectPtrOffset(DL, Slot, TypeSize::getFixed(2 * I));
+    SDValue Dst = DAG.getObjectPtrOffset(DL, S->getBasePtr(), TypeSize::getFixed(2 * I));
+    SDValue H = DAG.getLoad(MVT::i16, DL, Chain, Src,
+                            MachinePointerInfo(), Align(2));
+    Chain = DAG.getStore(H.getValue(1), DL, H, Dst,
+        S->getPointerInfo().getWithOffset(2 * I), Align(1),
+        S->getMemOperand()->getFlags());
+  }
+  return Chain;
+}
+
+static SDValue lowerKNCVector(SDValue Op, SelectionDAG &DAG) {
+  SDLoc DL(Op);
+  if (SDValue V = lowerKNCFP(Op, DL, DAG))
+    return V;
+  unsigned Opcode = Op.getOpcode();
+  EVT VT = Op.getValueType();
+  if (Opcode == ISD::SELECT &&
+      (VT == MVT::v16i32 || VT == MVT::v16f32 || VT == MVT::v8i64 ||
+       VT == MVT::v8f64)) {
+    SDValue Cond = Op.getOperand(0);
+    SDValue Bool = DAG.getSetCC(DL, MVT::i8, Cond,
+        DAG.getConstant(0, DL, Cond.getValueType()), ISD::SETNE);
+    Bool = DAG.getNode(ISD::AND, DL, MVT::i8, Bool,
+                        DAG.getConstant(1, DL, MVT::i8));
+    SDValue Mask = DAG.getNode(ISD::SUB, DL, MVT::i32,
+        DAG.getConstant(0, DL, MVT::i32),
+        DAG.getNode(ISD::ZERO_EXTEND, DL, MVT::i32, Bool));
+    return DAG.getBitcast(VT, kncWordBlend(
+        DAG.getBitcast(MVT::v16i32, Op.getOperand(2)),
+        DAG.getBitcast(MVT::v16i32, Op.getOperand(1)), Mask, DL, DAG));
+  }
+
+  if ((Opcode == ISD::FP_TO_SINT_SAT || Opcode == ISD::FP_TO_UINT_SAT) &&
+      VT == MVT::v8i64 && Op.getOperand(0).getValueType() == MVT::v8f64) {
+    unsigned Width = cast<VTSDNode>(Op.getOperand(1))->getVT().getSizeInBits();
+    if (Width > 64) return SDValue();
+    bool Signed = Opcode == ISD::FP_TO_SINT_SAT;
+    auto Splat = [&](uint64_t V) {
+      SmallVector<unsigned, 16> Words;
+      for (unsigned I = 0; I != 8; ++I) { Words.push_back(uint32_t(V)); Words.push_back(uint32_t(V >> 32)); }
+      return DAG.getBitcast(MVT::v8i64, kncI32Vector(Words, DL, DAG));
+    };
+    auto Bin = [&](unsigned Op, SDValue A, SDValue B) {
+      return DAG.getNode(Op, DL, MVT::v8i64, A, B);
+    };
+    auto Cmp = [&](SDValue A, SDValue B, ISD::CondCode CC) {
+      return kncCompareI64(A, B, CC, DL, DAG);
+    };
+    auto Select = [&](SDValue Cond, SDValue Yes, SDValue No) {
+      SDValue Mask = kncCompareMask(Cond, kncWordSplat(0, DL, DAG), ISD::SETNE, DL, DAG);
+      return DAG.getBitcast(MVT::v8i64, kncWordBlend(DAG.getBitcast(MVT::v16i32, No),
+          DAG.getBitcast(MVT::v16i32, Yes), Mask, DL, DAG));
+    };
+    SDValue Bits = DAG.getBitcast(MVT::v8i64, Op.getOperand(0)), Zero = Splat(0);
+    SDValue Abs = Bin(ISD::AND, Bits, Splat(UINT64_C(0x7fffffffffffffff)));
+    SDValue Exponent = Bin(ISD::SRL, Abs, Splat(52));
+    SDValue Mantissa = Bin(ISD::OR, Bin(ISD::AND, Abs, Splat(UINT64_C(0xfffffffffffff))), Splat(UINT64_C(1) << 52));
+    // Decode the exact truncated magnitude using integer shifts. Both shift
+    // counts are masked before LLVM shifts, including lanes later saturated.
+    SDValue LeftCount = Bin(ISD::AND, Bin(ISD::SUB, Exponent, Splat(1075)), Splat(63));
+    SDValue RightCount = Bin(ISD::AND, Bin(ISD::SUB, Splat(1075), Exponent), Splat(63));
+    SDValue Magnitude = Select(Cmp(Exponent, Splat(1075), ISD::SETUGE),
+        Bin(ISD::SHL, Mantissa, LeftCount), Bin(ISD::SRL, Mantissa, RightCount));
+    Magnitude = Select(Cmp(Exponent, Splat(1023), ISD::SETULT), Zero, Magnitude);
+    SDValue Negative = Cmp(Bits, Zero, ISD::SETLT);
+    SDValue Result = Signed ? Select(Negative, Bin(ISD::SUB, Zero, Magnitude), Magnitude) : Magnitude;
+    uint64_t Max = Signed ? (UINT64_C(1) << (Width - 1)) - 1 : UINT64_MAX >> (64 - Width);
+    SDValue Overflow = Cmp(Abs, Splat(uint64_t(1023 + (Signed ? Width - 1 : Width)) << 52), ISD::SETUGE);
+    SDValue Limit = Signed ? Select(Negative, Splat(~Max), Splat(Max)) : Splat(Max);
+    Result = Select(Overflow, Limit, Result);
+    if (!Signed) Result = Select(Negative, Zero, Result);
+    return Select(Cmp(Abs, Splat(UINT64_C(0x7ff0000000000000)), ISD::SETUGT), Zero, Result);
+  }
+  if (Opcode == ISD::SCALAR_TO_VECTOR &&
+      (VT == MVT::v8i64 || (KNCScalarRegisterReuse && VT == MVT::v16i32))) {
+    SDValue Scalar = Op.getOperand(0);
+    if (KNCScalarRegisterReuse && Scalar.getOpcode() == ISD::EXTRACT_VECTOR_ELT &&
+        Scalar.getOperand(0).getValueType() == VT &&
+        isNullConstant(Scalar.getOperand(1)))
+      return Scalar.getOperand(0);
+    if (KNCScalarRegisterReuse && KNCLoadBroadcast) {
+      auto *Load = dyn_cast<LoadSDNode>(Scalar);
+      if (Load && Scalar.hasOneUse() && Load->isSimple() && Load->isUnindexed() &&
+          Load->getAddressSpace() == 0 && Load->getExtensionType() == ISD::NON_EXTLOAD &&
+          Load->getMemoryVT() == Scalar.getValueType() &&
+          Load->getAlign() >= Align(Scalar.getValueType().getStoreSize()))
+        // KNC scalar broadcasts require natural 4/8-byte alignment. Leave this legal carrier for the memory-folding instruction pattern.
+        // The selector owns the load's chain and memory operand; no read is
+        // cloned, widened or detached from intervening stores here.
+        return Op;
+    }
+    // Remaining lanes are undefined, so broadcasting is a valid refinement.
+    // A BUILD_VECTOR here can fold back to SCALAR_TO_VECTOR indefinitely.
+    SDValue Slot = DAG.CreateStackTemporary(Scalar.getValueType());
+    SDValue Chain = DAG.getStore(DAG.getEntryNode(), DL, Scalar, Slot, MachinePointerInfo());
+    auto *N = DAG.getMachineNode(VT == MVT::v8i64 ? X86::KNC_VBROADCASTSD : X86::KNC_VBROADCASTSS, DL,
+                                 MVT::v16i32, MVT::Other, Slot, Chain);
+    return DAG.getBitcast(VT, SDValue(N, 0));
+  }
+  if (VT == MVT::v8i64) {
+    if (SDValue V = kncI64Binary(Opcode, Op.getOperand(0),
+        Op.getNumOperands() > 1 ? Op.getOperand(1) : SDValue(), DL, DAG))
+      return V;
+    if (Opcode == ISD::VSELECT) {
+      // X86 vector booleans are canonical zero/all-ones in every lane.
+      SDValue Cond = DAG.getBitcast(MVT::v16i32, Op.getOperand(0));
+      SDValue Mask = kncCompareMask(Cond, kncWordSplat(0, DL, DAG), ISD::SETNE, DL, DAG);
+      return DAG.getBitcast(VT, kncWordBlend(DAG.getBitcast(MVT::v16i32, Op.getOperand(2)),
+          DAG.getBitcast(MVT::v16i32, Op.getOperand(1)), Mask, DL, DAG));
+    }
+  }
+  if (Opcode == ISD::SETCC && Op.getOperand(0).getValueType() == MVT::v8i64) {
+    SDValue Bool = kncCompareI64(Op.getOperand(0), Op.getOperand(1),
+        cast<CondCodeSDNode>(Op.getOperand(2))->get(), DL, DAG);
+    if (Bool) return DAG.getBitcast(MVT::v8i64, Bool);
+  }
+  if ((Opcode == ISD::FP_TO_SINT_SAT || Opcode == ISD::FP_TO_UINT_SAT) &&
+      VT == MVT::v16i32 && Op.getOperand(0).getValueType() == MVT::v16f32) {
+    unsigned Width = cast<VTSDNode>(Op.getOperand(1))->getVT().getSizeInBits();
+    if (Width > 32)
+      return SDValue();
+    bool Signed = Opcode == ISD::FP_TO_SINT_SAT;
+    auto Splat = [&](uint32_t V) {
+      return kncI32Vector(SmallVector<unsigned, 16>(16, V), DL, DAG);
+    };
+    auto Blend = [&](SDValue A, SDValue B, SDValue Mask) {
+      return SDValue(DAG.getMachineNode(X86::KNC_BLEND_I32, DL, MVT::v16i32,
+                                        A, B, Mask), 0);
+    };
+    SDValue Bits = DAG.getBitcast(MVT::v16i32, Op.getOperand(0));
+    SDValue Zero = Splat(0);
+    SDValue Abs = DAG.getNode(ISD::AND, DL, MVT::v16i32, Bits, Splat(0x7fffffff));
+    SDValue Negative = kncCompareMask(Bits, Zero, ISD::SETLT, DL, DAG);
+    SDValue NaN = kncCompareMask(Abs, Splat(0x7f800000), ISD::SETUGT, DL, DAG);
+    unsigned Power = Signed ? Width - 1 : Width;
+    SDValue Overflow = kncCompareMask(Abs, Splat((127 + Power) << 23),
+                                      ISD::SETUGE, DL, DAG);
+    SDValue Unsafe = Signed ? Overflow
+                           : DAG.getNode(ISD::OR, DL, MVT::i32, Overflow, Negative);
+    // Clear NaNs/infinities/out-of-range lanes before conversion. Integer bit
+    // classification avoids FP comparisons and speculative invalid conversions.
+    SDValue Safe = Blend(Bits, Zero, Unsafe);
+    SDValue Result = DAG.getNode(Signed ? ISD::FP_TO_SINT : ISD::FP_TO_UINT,
+        DL, MVT::v16i32, DAG.getBitcast(MVT::v16f32, Safe));
+    uint32_t Max = Signed ? (uint32_t(1) << (Width - 1)) - 1
+                          : ~uint32_t(0) >> (32 - Width);
+    SDValue Limit = Signed ? Blend(Splat(Max), Splat(~Max), Negative) : Splat(Max);
+    Result = Blend(Result, Limit, Overflow);
+    if (!Signed)
+      Result = Blend(Result, Zero, Negative);
+    return Blend(Result, Zero, NaN);
+  }
+  if (Opcode == ISD::LOAD) {
+    auto *L = cast<LoadSDNode>(Op);
+    if (VT == MVT::v16f32 && L->getMemoryVT() == MVT::v16f16 && L->getExtensionType() == ISD::EXTLOAD) {
+      SDValue Chain = L->getChain();
+      SDValue Base = kncAlignWordLoad(L, Chain, DL, DAG);
+      bool Unaligned = L->getAlign() < Align(2);
+      auto *N = DAG.getMachineNode(X86::KNC_LOAD_EXT_F16, DL, MVT::v16f32, MVT::Other,
+                                   Base, Chain);
+      if (!Unaligned)
+        DAG.setNodeMemRefs(N, {L->getMemOperand()});
+      return SDValue(N, 0);
+    }
+    if (VT == MVT::v16i32 &&
+        (L->getMemoryVT() == MVT::v16i8 || L->getMemoryVT() == MVT::v16i16) &&
+        (L->getExtensionType() == ISD::SEXTLOAD || L->getExtensionType() == ISD::ZEXTLOAD ||
+         L->getExtensionType() == ISD::EXTLOAD)) {
+      bool Word = L->getMemoryVT() == MVT::v16i16;
+      bool Signed = L->getExtensionType() == ISD::SEXTLOAD;
+      unsigned Target = Word ? (Signed ? X86::KNC_LOAD_SEXT_I16 : X86::KNC_LOAD_ZEXT_I16)
+                             : (Signed ? X86::KNC_LOAD_SEXT_I8 : X86::KNC_LOAD_ZEXT_I8);
+      SDValue Chain = L->getChain();
+      SDValue Base = Word ? kncAlignWordLoad(L, Chain, DL, DAG) : L->getBasePtr();
+      auto *N = DAG.getMachineNode(Target, DL, MVT::v16i32, MVT::Other, Base, Chain);
+      if (!Word || L->getAlign() >= Align(2))
+        DAG.setNodeMemRefs(N, {L->getMemOperand()});
+      return SDValue(N, 0);
+    }
+  }
+  if (Opcode == ISD::STORE) {
+    auto *S = cast<StoreSDNode>(Op);
+    if (S->getValue().getValueType() == MVT::v16f32 && S->getMemoryVT() == MVT::v16f16) {
+      if (S->getAlign() < Align(2))
+        return kncUnalignedWordStore(S, X86::KNC_STORE_TRUNC_F16, DL, DAG,
+                                     S->getValue());
+      auto *N = DAG.getMachineNode(X86::KNC_STORE_TRUNC_F16, DL, MVT::Other,
+                                   S->getBasePtr(), S->getValue(), S->getChain());
+      DAG.setNodeMemRefs(N, {S->getMemOperand()});
+      return SDValue(N, 0);
+    }
+    if (S->getValue().getValueType() == MVT::v16i32 &&
+        (S->getMemoryVT() == MVT::v16i8 || S->getMemoryVT() == MVT::v16i16)) {
+      bool Word = S->getMemoryVT() == MVT::v16i16;
+      SmallVector<unsigned, 16> Mask(16, Word ? 65535 : 255);
+      SDValue V = DAG.getNode(ISD::AND, DL, MVT::v16i32, S->getValue(), kncI32Vector(Mask, DL, DAG));
+      unsigned Target = Word ? X86::KNC_STORE_TRUNC_I16 : X86::KNC_STORE_TRUNC_I8;
+      if (Word && S->getAlign() < Align(2))
+        return kncUnalignedWordStore(S, Target, DL, DAG, V);
+      auto *N = DAG.getMachineNode(Target, DL, MVT::Other,
+                                   S->getBasePtr(), V, S->getChain());
+      DAG.setNodeMemRefs(N, {S->getMemOperand()});
+      return SDValue(N, 0);
+    }
+  }
+  if (Opcode == ISD::VECTOR_SHUFFLE &&
+      (VT == MVT::v16i32 || VT == MVT::v16f32 || VT == MVT::v8f64 || VT == MVT::v8i64)) {
+    auto *N = cast<ShuffleVectorSDNode>(Op);
+    unsigned PerLane = (VT == MVT::v8f64 || VT == MVT::v8i64) ? 2 : 1;
+    SmallVector<unsigned, 16> Indices;
+    unsigned Mask = 0;
+    for (unsigned I = 0; I != 16 / PerLane; ++I) {
+      int Index = N->getMaskElt(I);
+      if (Index < 0) Index = 0;
+      for (unsigned J = 0; J != PerLane; ++J) {
+        Indices.push_back((Index * PerLane + J) & 15);
+        if (unsigned(Index) >= 16 / PerLane) Mask |= 1u << (I * PerLane + J);
+      }
+    }
+    SDValue Index = kncI32Vector(Indices, DL, DAG);
+    auto Permute = [&](SDValue V) {
+      return SDValue(DAG.getMachineNode(X86::KNC_VPERMDrr, DL, MVT::v16i32,
+                         Index, DAG.getBitcast(MVT::v16i32, V)), 0);
+    };
+    SDValue Result = Permute(Op.getOperand(0));
+    if (Mask)
+      Result = SDValue(DAG.getMachineNode(X86::KNC_BLEND_I32, DL, MVT::v16i32,
+          Result, Permute(Op.getOperand(1)), DAG.getConstant(Mask, DL, MVT::i32)), 0);
+    return DAG.getBitcast(VT, Result);
+  }
+  if (Opcode == ISD::SETCC && Op.getOperand(0).getValueType() == MVT::v16i32) {
+    auto CC = cast<CondCodeSDNode>(Op.getOperand(2))->get();
+    SDValue Mask = kncCompareMask(Op.getOperand(0), Op.getOperand(1), CC, DL, DAG);
+    if (!Mask) return SDValue();
+    SmallVector<unsigned, 16> Zero(16, 0), One(16, ~0u);
+    return SDValue(DAG.getMachineNode(X86::KNC_BLEND_I32, DL, MVT::v16i32,
+        kncI32Vector(Zero, DL, DAG), kncI32Vector(One, DL, DAG), Mask), 0);
+  }
+  if (Opcode == ISD::VSELECT && VT == MVT::v16i32 &&
+      Op.getOperand(0).getValueType() == MVT::v16i32) {
+    SmallVector<unsigned, 16> Zero(16, 0);
+    SDValue Mask = kncCompareMask(Op.getOperand(0), kncI32Vector(Zero, DL, DAG),
+                                 ISD::SETNE, DL, DAG);
+    return SDValue(DAG.getMachineNode(X86::KNC_BLEND_I32, DL, MVT::v16i32,
+        Op.getOperand(2), Op.getOperand(1), Mask), 0);
+  }
+  unsigned Binary = 0;
+  switch (Opcode) {
+  case ISD::VECREDUCE_ADD: Binary = ISD::ADD; break;
+  case ISD::VECREDUCE_MUL: Binary = ISD::MUL; break;
+  case ISD::VECREDUCE_AND: Binary = ISD::AND; break;
+  case ISD::VECREDUCE_OR: Binary = ISD::OR; break;
+  case ISD::VECREDUCE_XOR: Binary = ISD::XOR; break;
