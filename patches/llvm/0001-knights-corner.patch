+// KNC has no scalar FP register class, but its low vector lanes implement the
+// native scalar ABI. Keep scalar values bit-transported through integer types
+// and perform unconstrained arithmetic on legal full-register FP types. Reuse
+// low-lane registers through pure DAG nodes; materialize genuine GPR inputs
+// with explicit broadcasts instead of zero-initializing BUILD_VECTOR splats.
+// Strict/constrained operations and unsupported operations retain their runtime
+// paths. Only lane zero contributes to the scalar value contract.
+// Avoid a soft-float helper (and its vector register clobbers) for scalar
+// integers that the native dword conversion instructions can represent. The
+// scalar result is lane zero; keeping the integer carrier as SCALAR_TO_VECTOR
+// also folds a preceding low-lane reduction/extraction without a GPR round trip.
+// Wider integer conversions and constrained operations retain their old paths.
+// Look through a small scalar add/sub tree only when it contains a native
+// reduction or a low-lane vector value. Integer operations wrap exactly as the
+// scalar DAG does; do not copy scalar poison flags onto unspecified upper lanes.
+static SDValue kncIntReductionCarrier(SDValue Src, const SDLoc &DL,
+                                      SelectionDAG &DAG, bool &UsedVector,
+                                      unsigned Depth = 0) {
+  if (Src.getOpcode() == ISD::VECREDUCE_ADD &&
+      Src.getOperand(0).getValueType() == MVT::v16i32) {
+    UsedVector = true;
+    return kncReduceI32Vector(ISD::ADD, Src.getOperand(0), DL, DAG);
+  }
+  if (Src.getOpcode() == ISD::EXTRACT_VECTOR_ELT &&
+      Src.getOperand(0).getValueType() == MVT::v16i32 &&
+      isNullConstant(Src.getOperand(1))) {
+    UsedVector = true;
+    return Src.getOperand(0);
+  }
+  if (Depth < 3 && (Src.getOpcode() == ISD::ADD || Src.getOpcode() == ISD::SUB)) {
+    SDValue A = kncIntReductionCarrier(Src.getOperand(0), DL, DAG, UsedVector, Depth + 1);
+    SDValue B = kncIntReductionCarrier(Src.getOperand(1), DL, DAG, UsedVector, Depth + 1);
+    return DAG.getNode(Src.getOpcode(), DL, MVT::v16i32, A, B);
+  }
+  return DAG.getNode(ISD::SCALAR_TO_VECTOR, DL, MVT::v16i32, Src);
+}
