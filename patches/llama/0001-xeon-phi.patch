+void ggml_knl_q4_0_rows4(int n, float * GGML_RESTRICT out,
+        const void * GGML_RESTRICT vx, size_t stride, const void * GGML_RESTRICT vy) {
+    assert(n % QK4_0 == 0);
+    const block_q4_0 * rows[4];
+    const block_q8_0 * y = vy;
+    for (int r = 0; r < 4; ++r) rows[r] = (const block_q4_0 *)((const char *)vx + r * stride);
+    __m256 sums[4] = {_mm256_setzero_ps(), _mm256_setzero_ps(), _mm256_setzero_ps(), _mm256_setzero_ps()};
+    const __m256i off = _mm256_set1_epi8(8);
+    for (int ib = 0; ib < n / QK4_0; ++ib) {
+        const __m256i qy = _mm256_loadu_si256((const __m256i *)y[ib].qs);
+        const float dy = GGML_CPU_FP16_TO_FP32(y[ib].d);
+        for (int r = 0; r < 4; ++r) {
+            const __m256i qx = _mm256_sub_epi8(bytes_from_nibbles_32(rows[r][ib].qs), off);
+            const __m256 q = mul_sum_i8_pairs_float(qx, qy);
+            const __m256 d = _mm256_set1_ps(GGML_CPU_FP16_TO_FP32(rows[r][ib].d) * dy);
+            sums[r] = _mm256_fmadd_ps(d, q, sums[r]);
+        }
+    }
+    for (int r = 0; r < 4; ++r) out[r] = hsum_float_8(sums[r]);
+}
+#endif
