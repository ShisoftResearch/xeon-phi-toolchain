+            {K1OM_OP_FP_ADD, K1OM_TYPE_F32, K1OM_TYPE_F32,
+                16, 16, 0, K1OM_LAYOUT_NONE, K1OM_PROP_FP_RNE_VALUE, K1OM_ASSUME_DEFAULT_FP_ENV},
+#endif
+        };
+        state = ggml_k1om_quants_supported(true) &&
+            k1om_target_match_requirements(req, sizeof(req)/sizeof(req[0]), K1OM_ALLOW_DEFAULT).status == K1OM_MATCH_OK ? 1 : -1;
