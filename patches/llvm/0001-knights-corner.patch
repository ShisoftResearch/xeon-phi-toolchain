+  SDValue Result = DAG.getNode(N->getOpcode(), DL, VecFPVT, Inputs, Flags);
+  SDValue Bits = DAG.getBitcast(VecIntVT, Result);
+  Bits = DAG.getNode(ISD::EXTRACT_VECTOR_ELT, DL, IntVT, Bits,
+                     DAG.getVectorIdxConstant(0, DL));
+  return DAG.getBitcast(VT, Bits);
+}
