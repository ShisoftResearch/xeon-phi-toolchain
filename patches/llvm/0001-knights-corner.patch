+    return SDValue();
+  }
+  SDLoc DL(N);
+  bool Wide = VT == MVT::f64;
+  EVT IntVT = Wide ? MVT::i64 : MVT::i32;
+  EVT VecIntVT = Wide ? MVT::v8i64 : MVT::v16i32;
+  EVT VecFPVT = Wide ? MVT::v8f64 : MVT::v16f32;
