# RUN: llc -mcpu=knc -start-after=virtregrewriter -filetype=obj %s -o %t
# RUN: llvm-readobj --hex-dump=.text %t | FileCheck %s
# MPSS K1OM binutils independently assembled these exact operands/immediates.
# CHECK: 62f17808 c2c90062 b17800c2 f90162f1
# CHECK-NEXT: {{.*}}f908c2c9 0062b1f9 00c2f902 62f2f909
# CHECK-NEXT: {{.*}}65d16222 f90765f9 62f17908 dfd1c3
--- |
  target triple = "x86_64-unknown-linux-gnu"
  define void @fp_compare_encoding() #0 { ret void }
  attributes #0 = { "target-cpu"="knc" }
...
---
name: fp_compare_encoding
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $zmm0, $zmm1, $zmm16, $zmm17
    $k1 = KNC_VCMPPS $zmm0, $zmm1, 0
    $k7 = KNC_VCMPPS $zmm16, $zmm17, 1
    $k1 = KNC_VCMPPD $zmm0, $zmm1, 0
    $k7 = KNC_VCMPPD $zmm16, $zmm17, 2
    $zmm2 = KNC_VBLENDMPD $zmm0, $zmm1, $k1
    $zmm31 = KNC_VBLENDMPD $zmm16, $zmm17, $k7
    $zmm2 = KNC_VPANDNDrr $zmm0, $zmm1
    RET 0
...
