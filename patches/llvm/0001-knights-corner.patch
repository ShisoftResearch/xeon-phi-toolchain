+  SDValue Slot = DAG.CreateStackTemporary(MVT::v16i32);
+  Chain = SDValue(DAG.getMachineNode(X86::KNC_VMOVDQA32mr, DL, MVT::Other,
+                                    Slot, Vector, Chain), 0);
+  SDValue Bits = DAG.getLoad(VT, DL, Chain, Slot, MachinePointerInfo());
+  Chain = Bits.getValue(1);
+  return Bits;
+}
