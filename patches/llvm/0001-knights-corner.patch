+// Preserve sequential reduction order without repeatedly extracting a scalar
+// accumulator. Relaxed reductions use a native permutation tree instead.
+static SDValue lowerKNCFPReduction(SDNode *N, SelectionDAG &DAG) {
+  unsigned Opcode = N->getOpcode();
+  bool Seq = Opcode == ISD::VECREDUCE_SEQ_FADD ||
+             Opcode == ISD::VECREDUCE_SEQ_FMUL;
+  bool Mul = Opcode == ISD::VECREDUCE_SEQ_FMUL ||
+             Opcode == ISD::VECREDUCE_FMUL;
+  if (!Seq && Opcode != ISD::VECREDUCE_FADD &&
+      Opcode != ISD::VECREDUCE_FMUL)
+    return SDValue();
+  EVT VT = N->getValueType(0);
+  if (VT != MVT::f32 && VT != MVT::f64)
+    return SDValue();
+  SDValue Input = N->getOperand(Seq ? 1 : 0);
+  unsigned Lanes = Input.getValueType().getVectorNumElements();
+  if (Lanes < 2 || Lanes > 32 || !isPowerOf2_32(Lanes))
+    return SDValue();
+  bool Wide = VT == MVT::f64;
+  unsigned Width = Wide ? 8 : 16, Op = Mul ? ISD::FMUL : ISD::FADD;
+  EVT IntVT = Wide ? MVT::i64 : MVT::i32;
+  EVT VecIntVT = Wide ? MVT::v8i64 : MVT::v16i32;
+  EVT VecFPVT = Wide ? MVT::v8f64 : MVT::v16f32;
+  SDLoc DL(N);
+  auto Block = [&](unsigned Base) {
+    if (Lanes >= Width)
+      return Lanes == Width ? Input : DAG.getNode(ISD::EXTRACT_SUBVECTOR,
+          DL, VecFPVT, Input, DAG.getVectorIdxConstant(Base, DL));
+    EVT BitsVT = EVT::getVectorVT(*DAG.getContext(), IntVT, Lanes);
+    SDValue Bits = DAG.getBitcast(BitsVT, Input);
+    SmallVector<SDValue, 16> Words;
+    for (unsigned I = 0; I != Width; ++I)
+      Words.push_back(I < Lanes ? DAG.getNode(ISD::EXTRACT_VECTOR_ELT,
+          DL, IntVT, Bits, DAG.getVectorIdxConstant(I, DL))
+          : DAG.getConstant(0, DL, IntVT));
+    return DAG.getBitcast(VecFPVT, DAG.getBuildVector(VecIntVT, DL, Words));
+  };
+  auto Permute = [&](SDValue V, unsigned Index, bool Broadcast) {
+    SmallVector<unsigned, 16> Indices;
+    for (unsigned I = 0; I != Width; ++I) {
+      unsigned Lane = Broadcast ? Index : I ^ Index;
+      if (Wide) { Indices.push_back(2 * Lane); Indices.push_back(2 * Lane + 1); }
+      else Indices.push_back(Lane);
+    }
+    return DAG.getBitcast(VecFPVT, kncWordPermute(V, Indices, DL, DAG));
+  };
+  SDValue Acc;
+  if (Seq) {
+    SDNodeFlags ScalarFlags = N->getFlags();
+    if (KNCScalarRegisterReuse) {
+      // The scalar promise covers the observed accumulator, not unrelated
+      // upper-lane intermediates after reusing an unsplatted block.
+      ScalarFlags.setNoNaNs(false);
+      ScalarFlags.setNoInfs(false);
+    }
+    SDValue Slot = DAG.CreateStackTemporary(IntVT);
+    SDValue Chain = DAG.getStore(DAG.getEntryNode(), DL,
+        DAG.getBitcast(IntVT, N->getOperand(0)), Slot, MachinePointerInfo());
+    auto *B = DAG.getMachineNode(Wide ? X86::KNC_VBROADCASTSD
+                                     : X86::KNC_VBROADCASTSS,
+        DL, MVT::v16i32, MVT::Other, Slot, Chain);
+    Acc = DAG.getBitcast(VecFPVT, SDValue(B, 0));
+    for (unsigned Base = 0; Base < Lanes; Base += Width) {
+      SDValue V = Block(Base);
+      for (unsigned I = 0; I < std::min(Width, Lanes - Base); ++I)
+        // Only the final low lane is observed. Reuse the block directly for
+        // its first element; broadcasting lane zero is redundant, just as in
+        // scalar register transport. Later steps remain in original order.
+        Acc = DAG.getNode(Op, DL, VecFPVT, Acc,
+                           KNCScalarRegisterReuse && I == 0 ? V
+                                                           : Permute(V, I, true),
+                           ScalarFlags);
+    }
+  } else {
+    Acc = Block(0);
+    for (unsigned Base = Width; Base < Lanes; Base += Width)
+      Acc = DAG.getNode(Op, DL, VecFPVT, Acc, Block(Base), N->getFlags());
+    for (unsigned Step = std::min(Width, Lanes) / 2; Step; Step /= 2)
+      Acc = DAG.getNode(Op, DL, VecFPVT, Acc, Permute(Acc, Step, false),
+                         N->getFlags());
+  }
+  SDValue Bits = DAG.getBitcast(VecIntVT, Acc);
+  Bits = DAG.getNode(ISD::EXTRACT_VECTOR_ELT, DL, IntVT, Bits,
+                     DAG.getVectorIdxConstant(0, DL));
+  return DAG.getBitcast(VT, Bits);
+}
