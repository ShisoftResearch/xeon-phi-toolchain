+    SDValue Slot = DAG.CreateStackTemporary(IntVT);
+    SDValue Chain = DAG.getStore(DAG.getEntryNode(), DL,
+        DAG.getBitcast(IntVT, Input), Slot, MachinePointerInfo());
+    auto *Broadcast = DAG.getMachineNode(
+        Wide ? X86::KNC_VBROADCASTSD : X86::KNC_VBROADCASTSS, DL,
+        MVT::v16i32, MVT::Other, Slot, Chain);
+    Inputs.push_back(DAG.getBitcast(VecFPVT, SDValue(Broadcast, 0)));
+  }
