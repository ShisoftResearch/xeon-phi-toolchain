@@ -0,0 +1,17 @@
+// RUN: %clang_cc1 -triple x86_64-unknown-linux-gnu -target-cpu knc -E -dM %s | FileCheck %s
+// RUN: %clang_cc1 -triple x86_64-unknown-linux-gnu -target-cpu knc -target-feature -knc-scalar-fp -E -dM %s | FileCheck %s
+// RUN: %clang_cc1 -triple x86_64-unknown-linux-gnu -target-cpu knc -ffp-eval-method=source -E -dM %s | FileCheck %s
+// CHECK: #define __k1om 1
+// CHECK-NEXT: #define __k1om__ 1
+#if __FLT_EVAL_METHOD__ != 0
+#error KNC evaluates scalar operations at source precision
+#endif
+#ifdef __SSE__
+#error KNC has no SSE
+#endif
+#ifdef __SSE2__
+#error KNC has no SSE2
+#endif
+#ifdef __AVX512F__
+#error KNC IMCI is not AVX-512
+#endif
