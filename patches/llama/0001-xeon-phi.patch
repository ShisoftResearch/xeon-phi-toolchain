+            const int64_t col = (begin % columns)*256;
+            const int64_t stop = std::min(nc, (next - row*columns)*256);
+            const int64_t i12 = row/(ne11*ne10);
+            const int64_t i11 = (row - i12*ne11*ne10)/ne10;
+            const int64_t i10 = row % ne10;
+            const int64_t i01 = *(const int32_t *) ((const char *) src1->data + i10*nb10 + i11*nb11 + i12*nb12);
+            GGML_ASSERT(i01 >= 0 && i01 < ne01);
+            memcpy((char *) dst->data + i10*nb1 + i11*nb2 + i12*nb3 + col*sizeof(float),
+                   (const char *) src0->data + i01*nb01 + i11*nb02 + i12*nb03 + col*sizeof(float),
+                   (stop - col)*sizeof(float));
+            begin = next;
+        }
+        return;
+    }
+#endif
 
     // rows per thread
     const int dr = (nr + nth - 1)/nth;
