+static float ggml_k1om_dot_q6_K(int nb, const block_q6_K * x, const block_q8_K * y) {
+
+#ifdef GGML_K1OM_VECTOR_KSUMS
+    ggml_k1om_f32x16 vector_sums = {0};
+#else
+    float sums[8] = {0};
+#endif
+    for (int i = 0; i < nb; ++i) {
+        ggml_k1om_i32x16 acc = {0};
+#ifdef GGML_K1OM_Q6_VECTOR_SCALES
+        const ggml_k1om_i32x16 scales = ggml_k1om_load_i8(x[i].scales);
+#define GGML_K1OM_Q6_SEGMENT(T, P, H) do { \
+        enum { offset = (T) * 128 + (P) * 32 + (H) * 16, index = offset / 16 }; \
+        const ggml_k1om_i32x16 lo = ggml_k1om_load_u8(x[i].ql + (T) * 64 + ((P) % 2) * 32 + (H) * 16); \
+        const ggml_k1om_i32x16 hi = ggml_k1om_load_u8(x[i].qh + (T) * 32 + (H) * 16); \
+        const ggml_k1om_i32x16 q = ((lo >> (((P) / 2) * 4)) & 15) + (((hi >> ((P) * 2)) & 3) * 16) - 32; \
+        const ggml_k1om_i32x16 scale = __builtin_shufflevector(scales, scales, \
+            index,index,index,index,index,index,index,index,index,index,index,index,index,index,index,index); \
+        acc += q * ggml_k1om_load_i8(y[i].qs + offset) * scale; \
+    } while (0)
+        GGML_K1OM_Q6_SEGMENT(0, 0, 0);
+        GGML_K1OM_Q6_SEGMENT(0, 0, 1);
+        GGML_K1OM_Q6_SEGMENT(0, 1, 0);
+        GGML_K1OM_Q6_SEGMENT(0, 1, 1);
+        GGML_K1OM_Q6_SEGMENT(0, 2, 0);
+        GGML_K1OM_Q6_SEGMENT(0, 2, 1);
+        GGML_K1OM_Q6_SEGMENT(0, 3, 0);
+        GGML_K1OM_Q6_SEGMENT(0, 3, 1);
+        GGML_K1OM_Q6_SEGMENT(1, 0, 0);
+        GGML_K1OM_Q6_SEGMENT(1, 0, 1);
+        GGML_K1OM_Q6_SEGMENT(1, 1, 0);
+        GGML_K1OM_Q6_SEGMENT(1, 1, 1);
+        GGML_K1OM_Q6_SEGMENT(1, 2, 0);
+        GGML_K1OM_Q6_SEGMENT(1, 2, 1);
+        GGML_K1OM_Q6_SEGMENT(1, 3, 0);
+        GGML_K1OM_Q6_SEGMENT(1, 3, 1);
+#undef GGML_K1OM_Q6_SEGMENT
+#else
+        for (int tile = 0; tile < 2; ++tile) {
+            for (int part = 0; part < 4; ++part) {
+                for (int half = 0; half < 2; ++half) {
+                    const int offset = tile * 128 + part * 32 + half * 16;
+                    const ggml_k1om_i32x16 lo = ggml_k1om_load_u8(x[i].ql + tile * 64 + (part % 2) * 32 + half * 16);
+                    const ggml_k1om_i32x16 hi = ggml_k1om_load_u8(x[i].qh + tile * 32 + half * 16);
+                    const ggml_k1om_i32x16 q = ((lo >> ((part / 2) * 4)) & 15)
+                        + (((hi >> (part * 2)) & 3) * 16) - 32;
+                    acc += q * ggml_k1om_load_i8(y[i].qs + offset) * (int)x[i].scales[offset / 16];
+                }
+            }
+        }
+#endif
+        const float d = GGML_CPU_FP16_TO_FP32(x[i].d) * y[i].d;
+#ifdef GGML_K1OM_VECTOR_KSUMS
+        vector_sums = ggml_k1om_accumulate8(vector_sums, acc, d);
+#else
+        int32_t aux[8];
+        ggml_k1om_fold8(acc, aux);
+        for (int l = 0; l < 8; ++l) sums[l] += d * aux[l];
+#endif
+    }
+    float sum = 0;
+#ifdef GGML_K1OM_VECTOR_KSUMS
+    float sums[8];
+    memcpy(sums, &vector_sums, sizeof(sums));
+#endif
+    for (int l = 0; l < 8; ++l) sum += sums[l];
+    return sum;
+}
+
+static float ggml_k1om_dot_q5_K(int nb, const block_q5_K * x, const block_q8_K * y) {
+
+#ifdef GGML_K1OM_VECTOR_KSUMS
+    ggml_k1om_f32x16 vector_sums = {0};
+#else
+    float sums[8] = {0};
+#endif
+    float sum = 0;
+    for (int i = 0; i < nb; ++i) {
+        uint32_t tmp[4];
+        memcpy(tmp, x[i].scales, 12);
+        tmp[3] = ((tmp[2] >> 4) & 0x0f0f0f0f) | (((tmp[1] >> 6) & 0x03030303) << 4);
+        const uint32_t a = tmp[1] & 0x3f3f3f3f;
+        tmp[1] = (tmp[2] & 0x0f0f0f0f) | (((tmp[0] >> 6) & 0x03030303) << 4);
+        tmp[2] = a;
+        tmp[0] &= 0x3f3f3f3f;
+        const uint8_t * scales = (const uint8_t *)tmp;
+        const uint8_t * mins = scales + 8;
+        int minsum = 0;
+        for (int j = 0; j < 16; ++j) minsum += y[i].bsums[j] * mins[j / 2];
+        ggml_k1om_i32x16 acc = {0};
+        for (int tile = 0; tile < 4; ++tile) {
+            for (int half = 0; half < 2; ++half) {
+                const ggml_k1om_i32x16 packed = ggml_k1om_load_u8(x[i].qs + tile * 32 + half * 16);
+                const ggml_k1om_i32x16 high = ggml_k1om_load_u8(x[i].qh + half * 16);
+                const ggml_k1om_i32x16 lowq = (packed & 15) + (((high >> (tile * 2)) & 1) * 16);
+                const ggml_k1om_i32x16 highq = (packed >> 4) + (((high >> (tile * 2 + 1)) & 1) * 16);
+                acc += lowq * ggml_k1om_load_i8(y[i].qs + tile * 64 + half * 16) * (int)scales[tile * 2];
+                acc += highq * ggml_k1om_load_i8(y[i].qs + tile * 64 + 32 + half * 16) * (int)scales[tile * 2 + 1];
+            }
+        }
+        const float d = GGML_CPU_FP16_TO_FP32(x[i].d) * y[i].d;
+#ifdef GGML_K1OM_VECTOR_KSUMS
+        vector_sums = ggml_k1om_accumulate8(vector_sums, acc, d);
+#else
+        int32_t aux[8];
+        ggml_k1om_fold8(acc, aux);
+        for (int l = 0; l < 8; ++l) sums[l] += d * aux[l];
+#endif
+        const float dmin = GGML_CPU_FP16_TO_FP32(x[i].dmin) * y[i].d;
+        sum -= dmin * minsum;
+    }
+#ifdef GGML_K1OM_VECTOR_KSUMS
+    float sums[8];
+    memcpy(sums, &vector_sums, sizeof(sums));
+#endif
+    for (int l = 0; l < 8; ++l) sum += sums[l];
+    return sum;
+}
+
+
+#ifdef GGML_K1OM_Q4_VECTOR_ACCUM
+static ggml_k1om_f32x16 ggml_k1om_q4_accumulate(
+        ggml_k1om_f32x16 sum, ggml_k1om_i32x16 dot, float dx, float dy) {
+#pragma clang fp contract(off)
+    dot += __builtin_shufflevector(dot,dot,8,9,10,11,12,13,14,15,0,1,2,3,4,5,6,7);
+    dot += __builtin_shufflevector(dot,dot,4,5,6,7,0,1,2,3,12,13,14,15,8,9,10,11);
+    dot += __builtin_shufflevector(dot,dot,2,3,0,1,6,7,4,5,10,11,8,9,14,15,12,13);
+    dot += __builtin_shufflevector(dot,dot,1,0,3,2,5,4,7,6,9,8,11,10,13,12,15,14);
+    const ggml_k1om_f32x16 values = __builtin_convertvector(dot,ggml_k1om_f32x16);
+    return sum + (values * dx) * dy;
+}
+#endif
+
+#if defined(GGML_K1OM_Q4_PREFETCH) && GGML_K1OM_Q4_PREFETCH > 0
+static inline void ggml_k1om_prefetch_l1(const void * p) {
+    // Native vprefetch0 (%rax); the input constraint fixes the encoded address register.
+    __asm__ volatile(".byte 0xc5, 0xf8, 0x18, 0x08" : : "a"(p));
+}
+#endif
+
+// Four independent output rows share the widened activation block. Each row
+// retains the single-row block order and scale expressions.
+void ggml_k1om_q4_0_rows4(int n, float * GGML_RESTRICT out,
+        const void * GGML_RESTRICT vx, size_t stride, const void * GGML_RESTRICT vy) {
+    assert(n % QK4_0 == 0);
+    const block_q8_0 * y = vy;
+    const block_q4_0 * rows[4];
+    for (int r = 0; r < 4; ++r) rows[r] = (const block_q4_0 *)((const char *)vx + r * stride);
+#ifdef GGML_K1OM_Q4_VECTOR_ACCUM
+    ggml_k1om_f32x16 accumulators[4] = {{0},{0},{0},{0}};
+#else
+    float sums[4] = {0};
+#endif
+    for (int ib = 0; ib < n / QK4_0; ++ib) {
+#if defined(GGML_K1OM_Q4_PREFETCH) && GGML_K1OM_Q4_PREFETCH > 0
+        if (ib + GGML_K1OM_Q4_PREFETCH < n / QK4_0) {
+            for (int r = 0; r < 4; ++r) {
+                ggml_k1om_prefetch_l1(&rows[r][ib + GGML_K1OM_Q4_PREFETCH]);
+            }
+        }
+#endif
+        const ggml_k1om_i32x16 a = ggml_k1om_load_i8(y[ib].qs);
+        const ggml_k1om_i32x16 b = ggml_k1om_load_i8(y[ib].qs + 16);
+        const float dy = GGML_CPU_FP16_TO_FP32(y[ib].d);
+        for (int r = 0; r < 4; ++r) {
+            const ggml_k1om_i32x16 q = ggml_k1om_load_u8(rows[r][ib].qs);
+#ifdef GGML_K1OM_Q4_VECTOR_ACCUM
+            const ggml_k1om_i32x16 products = ((q & 15) - 8) * a + ((q >> 4) - 8) * b;
+            accumulators[r] = ggml_k1om_q4_accumulate(accumulators[r], products,
+                GGML_CPU_FP16_TO_FP32(rows[r][ib].d), dy);
+#else
+            const int dot = __builtin_reduce_add(((q & 15) - 8) * a + ((q >> 4) - 8) * b);
+            sums[r] += dot * GGML_CPU_FP16_TO_FP32(rows[r][ib].d) * dy;
+#endif
+        }
+    }
+#ifdef GGML_K1OM_Q4_VECTOR_ACCUM
+    for (int r = 0; r < 4; ++r) out[r] = accumulators[r][0];
+#else
+    memcpy(out, sums, sizeof(sums));
+#endif
+}
+
+#ifdef GGML_K1OM_MM_TILES
+void ggml_k1om_q4_0_rows4_cols2(int n, float * GGML_RESTRICT out,
+        const void * GGML_RESTRICT vx, size_t stride,
+        const void * GGML_RESTRICT vy, size_t column_stride) {
+    assert(n % QK4_0 == 0);
+    const block_q4_0 * rows[4];
+    const block_q8_0 * columns[2];
+    for (int r = 0; r < 4; ++r) rows[r] = (const block_q4_0 *)((const char *)vx + r * stride);
+    for (int c = 0; c < 2; ++c) columns[c] = (const block_q8_0 *)((const char *)vy + c * column_stride);
+    ggml_k1om_f32x16 sums[2][4] = {{{0}}};
+    for (int ib = 0; ib < n / QK4_0; ++ib) {
+#if defined(GGML_K1OM_Q4_PREFETCH) && GGML_K1OM_Q4_PREFETCH > 0
+        if (ib + GGML_K1OM_Q4_PREFETCH < n / QK4_0) {
+            for (int r = 0; r < 4; ++r) {
+                ggml_k1om_prefetch_l1(&rows[r][ib + GGML_K1OM_Q4_PREFETCH]);
+            }
+        }
+#endif
+        const ggml_k1om_i32x16 a0 = ggml_k1om_load_i8(columns[0][ib].qs);
+        const ggml_k1om_i32x16 b0 = ggml_k1om_load_i8(columns[0][ib].qs + 16);
+        const ggml_k1om_i32x16 a1 = ggml_k1om_load_i8(columns[1][ib].qs);
+        const ggml_k1om_i32x16 b1 = ggml_k1om_load_i8(columns[1][ib].qs + 16);
+        const float dy0 = GGML_CPU_FP16_TO_FP32(columns[0][ib].d);
+        const float dy1 = GGML_CPU_FP16_TO_FP32(columns[1][ib].d);
+        for (int r = 0; r < 4; ++r) {
+            const ggml_k1om_i32x16 q = ggml_k1om_load_u8(rows[r][ib].qs);
+            const ggml_k1om_i32x16 low = (q & 15) - 8;
