+#ifdef GGML_K1OM_PARALLEL_ACTIVATIONS
+// Preserve each element's existing math. Partition cache-line-sized column
+// blocks when there are too few rows to occupy the KNC thread team.
+static bool ggml_k1om_activation_range(const ggml_compute_params * params,
+                                      int64_t nc, int64_t nr,
+                                      int64_t & begin, int64_t & end) {
+    if (params->use_ref || params->nth <= 1 || nr >= params->nth || nc < 128) {
+        return false;
+    }
+    const int64_t blocks = nr*((nc + 15)/16);
+    begin = blocks*params->ith/params->nth;
+    end = blocks*(params->ith + 1)/params->nth;
+    return true;
+}
+
+static bool ggml_k1om_disjoint(const ggml_tensor * a, const ggml_tensor * b) {
+    const uintptr_t x = (uintptr_t) a->data, y = (uintptr_t) b->data;
+    return x <= y ? ggml_nbytes(a) <= y - x : ggml_nbytes(b) <= x - y;
+}
+#endif
