+        // avoids extraction/store/broadcast round trips; other lanes remain
+        // unspecified. This path is already excluded for strict FP operations.
+        Inputs.push_back(DAG.getBitcast(VecFPVT, Bits.getOperand(0)));
+        continue;
+      }
+      if (Input.getOpcode() == ISD::EXTRACT_VECTOR_ELT &&
+          Input.getOperand(0).getValueType() == VecFPVT &&
+          isNullConstant(Input.getOperand(1))) {
+        Inputs.push_back(Input.getOperand(0));
+        continue;
+      }
+      // A producer may not have been combined yet. Keep this transport as a
+      // pure DAG node so a later low-lane extraction can fold through it.
+      Inputs.push_back(DAG.getBitcast(VecFPVT,
+          DAG.getNode(ISD::SCALAR_TO_VECTOR, DL, VecIntVT, Bits)));
+      continue;
