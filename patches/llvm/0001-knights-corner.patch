diff --git a/clang/test/CodeGen/X86/knc.c b/clang/test/CodeGen/X86/knc.c
new file mode 100644
index 000000000..c08726737
--- /dev/null
+++ b/clang/test/CodeGen/X86/knc.c
@@ -0,0 +1,18 @@
+// REQUIRES: x86-registered-target
+// RUN: %clang_cc1 -triple x86_64-unknown-linux-gnu -target-cpu knc -emit-llvm -O1 -o - %s | FileCheck %s
+// RUN: %clang_cc1 -triple x86_64-unknown-linux-gnu -target-cpu knc -emit-obj -O1 -o %t %s
+// RUN: llvm-readobj -h %t | FileCheck %s --check-prefix=ELF
+// RUN: %clang_cc1 -triple x86_64-unknown-linux-gnu -target-cpu knc -target-feature -knc-scalar-fp -emit-llvm -O1 -o - %s | FileCheck %s --check-prefix=SOFT
+// ELF: Machine: EM_K10M (0xB5)
+// SOFT: "target-features"={{.*}}-knc-scalar-fp
+// CHECK-LABEL: define{{.*}} float @half_to_float
+// CHECK: fpext half
+float half_to_float(const _Float16 *p) { return *p; }
+// CHECK-LABEL: define{{.*}} void @float_to_half
+// CHECK: fptrunc float
+void float_to_half(_Float16 *p,float v) { *p=v; }
+// CHECK-LABEL: define{{.*}} double @variadic
+// CHECK: @llvm.va_start
+// CHECK: "target-cpu"="knc"
+// CHECK-SAME: "target-features"="+cx8,+fxsr,+knc,+knc-native-abi,+knc-scalar-fp,+soft-float,+x87"
+double variadic(int n,...) { __builtin_va_list a;__builtin_va_start(a,n);double sum=0;for(int i=0;i<n;i++)sum+=__builtin_va_arg(a,double);__builtin_va_end(a);return sum; }
