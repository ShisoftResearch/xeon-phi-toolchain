+  if (KNCScalarRegisterReuse) {
+    // nnan/ninf were promises about the scalar operands/result. Upper lanes
+    // can contain arbitrary values, so do not attach these poison-generating
+    // assumptions to their widened operations.
+    Flags.setNoNaNs(false);
+    Flags.setNoInfs(false);
