# RUN: llc -mcpu=knc -start-after=virtregrewriter -filetype=obj %s -o %t
# RUN: llvm-readobj --hex-dump=.text %t | FileCheck %s
# Independently assembled using MPSS K1OM binutils, including high ZMM registers.
# CHECK: 62f27908 86d16222 790086f9 c3
--- |
  target triple = "x86_64-unknown-linux-gnu"
  define void @mulhud() #0 { ret void }
  attributes #0 = { "target-cpu"="knc" }
...
---
name: mulhud
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $zmm0, $zmm1, $zmm16, $zmm17
    $zmm2 = KNC_VPMULHUDrr $zmm0, $zmm1
    $zmm31 = KNC_VPMULHUDrr $zmm16, $zmm17
    RET 0
...
