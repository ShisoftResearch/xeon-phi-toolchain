+// Calibrated on KNC with 524288-operation dependent chains (seven medians).
+// Keep unmeasured instructions on the established generic fallback path.
+static cl::opt<bool> KNCFPScheduling(
+    "knc-fp-scheduling", cl::Hidden, cl::init(true),
+    cl::desc("Use measured KNC floating-point instruction latencies"));
+
+static unsigned getKNCMeasuredLatency(unsigned Opcode) {
+  switch (Opcode) {
+  case X86::KNC_VPADDDrr:
+  case X86::KNC_VPMULLDrr:
+  case X86::KNC_VPMULHUDrr:
+  case X86::KNC_VPSLLVDrr:
+    return 4;
+  case X86::KNC_VPERMDrr:
+    return 6;
+  case X86::KNC_VADDPSrr:
+  case X86::KNC_VADDPDrr:
+  case X86::KNC_VSUBPSrr:
+  case X86::KNC_VSUBPDrr:
+  case X86::KNC_VMULPSrr:
+  case X86::KNC_VMULPDrr:
+  case X86::KNC_VFMADD132PS:
+  case X86::KNC_VFMADD132PD:
+    return KNCFPScheduling ? 4 : 0;
+  case X86::KNC_VRCP23PS:
+  case X86::KNC_VRSQRT23PS:
+    return KNCFPScheduling ? 6 : 0;
+  default:
+    return 0;
+  }
+}
+
+unsigned X86InstrInfo::getInstrLatency(const InstrItineraryData *ItinData,
+                                      const MachineInstr &MI,
+                                      unsigned *PredCost) const {
+  if (Subtarget.isKNC())
+    if (unsigned Latency = getKNCMeasuredLatency(MI.getOpcode())) {
+      if (PredCost)
+        *PredCost = 0;
+      return Latency;
+    }
+  return X86GenInstrInfo::getInstrLatency(ItinData, MI, PredCost);
+}
+
+unsigned X86InstrInfo::getInstrLatency(const InstrItineraryData *ItinData,
+                                      SDNode *Node) const {
+  if (Subtarget.isKNC() && Node->isMachineOpcode())
+    if (unsigned Latency = getKNCMeasuredLatency(Node->getMachineOpcode()))
+      return Latency;
+  return X86GenInstrInfo::getInstrLatency(ItinData, Node);
+}
+
 static unsigned getStoreRegOpcode(Register SrcReg,
                                   const TargetRegisterClass *RC,
                                   bool IsStackAligned,
                                   const X86Subtarget &STI) {
+  if (STI.isKNC() && RC == &X86::VR512RegClass) {
+    assert(IsStackAligned && "KNC vector spills require 64-byte alignment");
+    return X86::KNC_VMOVDQA32mr_full;
+  }
   return getLoadStoreRegOpcode(SrcReg, RC, IsStackAligned, STI, false);
 }
 
 static unsigned getLoadRegOpcode(Register DestReg,
                                  const TargetRegisterClass *RC,
                                  bool IsStackAligned, const X86Subtarget &STI) {
+  if (STI.isKNC() && RC == &X86::VR512RegClass) {
+    assert(IsStackAligned && "KNC vector reloads require 64-byte alignment");
+    return X86::KNC_VMOVDQA32rm_full;
+  }
   return getLoadStoreRegOpcode(DestReg, RC, IsStackAligned, STI, true);
 }
 
