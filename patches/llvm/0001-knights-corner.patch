+namespace {
+// Preserve the original FP classification after soft-float legalization has
+// replaced f32/f64 with i32/i64. Integer and FP register banks are independent.
+class KNCCCState : public CCState {
+  SmallVector<bool, 16> FP;
+  bool Native, Return;
+public:
+  template <typename Args>
+  KNCCCState(CallingConv::ID CC, bool VarArg, MachineFunction &MF,
+             SmallVectorImpl<CCValAssign> &Locs, LLVMContext &Ctx,
+             const Args &Arguments, bool IsReturn, bool IsNative)
+      : CCState(CC, VarArg, MF, Locs, Ctx), Native(IsNative), Return(IsReturn) {
+    for (const auto &Arg : Arguments)
+      FP.push_back(Arg.OrigTy &&
+                   (Arg.OrigTy->isFloatTy() || Arg.OrigTy->isDoubleTy()));
+  }
+  static bool assign(unsigned ValNo, MVT ValVT, MVT LocVT,
+                     CCValAssign::LocInfo LocInfo, ISD::ArgFlagsTy Flags,
+                     Type *OrigTy, CCState &State) {
+    auto &S = static_cast<KNCCCState &>(State);
+    bool Vector = ValVT == MVT::v16i32 || ValVT == MVT::v16f32 ||
+                  ValVT == MVT::v8f64 || ValVT == MVT::v8i64;
+    if (!S.Native || (!Vector &&
+        !(OrigTy && (OrigTy->isFloatTy() || OrigTy->isDoubleTy()))))
+      return (S.Return ? RetCC_X86 : CC_X86)(ValNo, ValVT, LocVT,
+                                             LocInfo, Flags, OrigTy, State);
+    static const MCPhysReg Regs[] = {
+      X86::ZMM0, X86::ZMM1, X86::ZMM2, X86::ZMM3,
+      X86::ZMM4, X86::ZMM5, X86::ZMM6, X86::ZMM7
+    };
+    ArrayRef<MCPhysReg> Available(Regs, S.Return ? 2 : 8);
+    if (MCRegister R = S.AllocateReg(Available)) {
+      S.addLoc(CCValAssign::getReg(ValNo, ValVT, R,
+                                  Vector ? ValVT : MVT::v16i32,
+                                  CCValAssign::Full));
+      return false;
+    }
+    if (S.Return)
+      return true;
+    S.addLoc(CCValAssign::getMem(ValNo, ValVT,
+                                S.AllocateStack(Vector ? 64 : 8, Align(Vector ? 64 : 8)), ValVT,
+                                CCValAssign::Full));
+    return false;
+  }
+};
+
+static bool isKNCScalarReg(const CCValAssign &VA) {
+  return VA.isRegLoc() && VA.getLocVT() == MVT::v16i32 &&
+         (VA.getValVT() == MVT::i32 || VA.getValVT() == MVT::i64);
+}
+
+static SDValue packKNCScalar(SDValue Bits, SDValue &Chain, const SDLoc &DL,
+                             SelectionDAG &DAG) {
+  MVT IntVT = Bits.getValueType() == MVT::i64 ? MVT::v8i64 : MVT::v16i32;
+  if (KNCScalarRegisterReuse)
+    // Defer materialization until scalar arithmetic has been combined. The
+    // low lane is the scalar ABI value; upper lanes are unspecified.
+    return DAG.getBitcast(MVT::v16i32,
+        DAG.getNode(ISD::SCALAR_TO_VECTOR, DL, IntVT, Bits));
+  SDValue Slot = DAG.CreateStackTemporary(Bits.getValueType());
+  Chain = DAG.getStore(Chain, DL, Bits, Slot, MachinePointerInfo());
+  unsigned Op = Bits.getValueType() == MVT::i32 ? X86::KNC_VBROADCASTSS
+                                               : X86::KNC_VBROADCASTSD;
+  auto *N = DAG.getMachineNode(Op, DL, MVT::v16i32, MVT::Other, Slot, Chain);
+  Chain = SDValue(N, 1);
+  return SDValue(N, 0);
+}
+
+static SDValue unpackKNCScalar(SDValue Vector, MVT VT, SDValue &Chain,
+                               const SDLoc &DL, SelectionDAG &DAG) {
+  if (KNCScalarRegisterReuse) {
+    MVT IntVT = VT == MVT::i64 ? MVT::v8i64 : MVT::v16i32;
+    return DAG.getNode(ISD::EXTRACT_VECTOR_ELT, DL, VT,
+                       DAG.getBitcast(IntVT, Vector),
+                       DAG.getVectorIdxConstant(0, DL));
