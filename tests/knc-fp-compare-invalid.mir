# RUN: not llc -mcpu=knc -start-after=virtregrewriter -filetype=obj %s -o /dev/null 2>&1 | FileCheck %s
# AVX's later predicates encode but trap on real KNC; diagnose the ISA mismatch.
# CHECK: error: KNC floating comparisons only support predicates 0..7
--- |
  target triple = "x86_64-unknown-linux-gnu"
  define void @invalid_fp_predicate() #0 { ret void }
  attributes #0 = { "target-cpu"="knc" }
...
---
name: invalid_fp_predicate
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $zmm0, $zmm1
    $k1 = KNC_VCMPPS $zmm0, $zmm1, 17
    RET 0
...
