+static int32_t ggml_k1om_dot_q4_block(const uint8_t * x, const int8_t * y) {
+    ggml_k1om_u8x16 packed;
+    ggml_k1om_i8x16 y0, y1;
+    memcpy(&packed, x, 16);
+    memcpy(&y0, y, 16);
+    memcpy(&y1, y + 16, 16);
+    ggml_k1om_i32x16 u = __builtin_convertvector(packed, ggml_k1om_i32x16);
+    ggml_k1om_i32x16 a = __builtin_convertvector(y0, ggml_k1om_i32x16);
+    ggml_k1om_i32x16 b = __builtin_convertvector(y1, ggml_k1om_i32x16);
+    return __builtin_reduce_add(((u & 15) - 8) * a + ((u >> 4) - 8) * b);
+}
+
+static int32_t ggml_k1om_dot_q8_block(const int8_t * x, const int8_t * y) {
+    ggml_k1om_i8x16 x0, x1, y0, y1;
+    memcpy(&x0, x, 16);
+    memcpy(&x1, x + 16, 16);
+    memcpy(&y0, y, 16);
+    memcpy(&y1, y + 16, 16);
+    ggml_k1om_i32x16 a = __builtin_convertvector(x0, ggml_k1om_i32x16);
+    ggml_k1om_i32x16 b = __builtin_convertvector(x1, ggml_k1om_i32x16);
+    ggml_k1om_i32x16 c = __builtin_convertvector(y0, ggml_k1om_i32x16);
+    ggml_k1om_i32x16 d = __builtin_convertvector(y1, ggml_k1om_i32x16);
+    return __builtin_reduce_add(a * c + b * d);
+}
+// The same matched integer building blocks implement K-format unpacking.
+// Folding lanes 8..15 onto lanes 0..7 preserves the generic eight integer
+// partial sums and, consequently, its floating-point accumulation order.
+bool ggml_k1om_kquants_supported(void) {
+    static int cached;
+    int state = __atomic_load_n(&cached, __ATOMIC_RELAXED);
+    if (state == 0) {
+        const k1om_requirement req[] = {
+            {K1OM_OP_PERMUTE_I32, K1OM_TYPE_I32, K1OM_TYPE_I32,
+                16, 16, 0, K1OM_LAYOUT_NONE, K1OM_PROP_COPY_BITS, 0},
+#ifdef GGML_K1OM_VECTOR_KSUMS
+            {K1OM_OP_INT_TO_FP_S, K1OM_TYPE_I32, K1OM_TYPE_F32,
+                16, 16, 0, K1OM_LAYOUT_NONE, K1OM_PROP_FP_RNE_VALUE, K1OM_ASSUME_DEFAULT_FP_ENV},
+            {K1OM_OP_FP_MUL, K1OM_TYPE_F32, K1OM_TYPE_F32,
