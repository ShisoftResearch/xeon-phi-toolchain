+
+static ggml_k1om_i32x16 ggml_k1om_load_i8(const int8_t * p) {
+    ggml_k1om_i8x16 v;
+    memcpy(&v, p, 16);
+    return __builtin_convertvector(v, ggml_k1om_i32x16);
