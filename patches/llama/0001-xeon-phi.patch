+#ifdef GGML_K1OM_VECTOR_KSUMS
+// The low eight lanes preserve the original eight independent FP accumulators.
+// No reassociation or horizontal FP reduction is permitted here.
+static ggml_k1om_f32x16 ggml_k1om_accumulate8(
+        ggml_k1om_f32x16 sums, ggml_k1om_i32x16 acc, float d) {
+#pragma clang fp contract(off)
+    acc += __builtin_shufflevector(acc, acc, 8,9,10,11,12,13,14,15,0,1,2,3,4,5,6,7);
+    const ggml_k1om_f32x16 values = __builtin_convertvector(acc, ggml_k1om_f32x16);
+    return sums + values * d;
+}
+#endif
