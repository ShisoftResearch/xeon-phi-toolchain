+static SDValue lowerKNCScalarIntToFP(SDNode *N, SelectionDAG &DAG) {
+  unsigned Opcode = N->getOpcode();
+  if (Opcode != ISD::SINT_TO_FP && Opcode != ISD::UINT_TO_FP)
+    return SDValue();
+  EVT DstVT = N->getValueType(0);
+  SDValue Src = N->getOperand(0);
+  EVT SrcVT = Src.getValueType();
+  if ((DstVT != MVT::f32 && DstVT != MVT::f64) ||
+      !SrcVT.isScalarInteger() || SrcVT.getSizeInBits() > 32)
+    return SDValue();
+  SDLoc DL(N);
+  bool Signed = Opcode == ISD::SINT_TO_FP;
+  if (SrcVT != MVT::i32)
+    Src = DAG.getNode(Signed ? ISD::SIGN_EXTEND : ISD::ZERO_EXTEND,
+                      DL, MVT::i32, Src);
+  SDValue Carrier;
+  if (KNCScalarRegisterReuse) {
+    if (KNCIntReduceRegisters) {
+      bool UsedVector = false;
+      SDValue Candidate = kncIntReductionCarrier(Src, DL, DAG, UsedVector);
+      if (UsedVector)
+        Carrier = Candidate;
+    }
+    if (!Carrier)
+      Carrier = DAG.getNode(ISD::SCALAR_TO_VECTOR, DL, MVT::v16i32, Src);
+  } else {
+    SDValue Slot = DAG.CreateStackTemporary(MVT::i32);
+    SDValue Chain = DAG.getStore(DAG.getEntryNode(), DL, Src, Slot,
+                                 MachinePointerInfo());
+    Carrier = SDValue(DAG.getMachineNode(X86::KNC_VBROADCASTSS, DL,
+        MVT::v16i32, MVT::Other, Slot, Chain), 0);
+  }
+  bool Wide = DstVT == MVT::f64;
+  unsigned MC = Wide ? (Signed ? X86::KNC_CVT_I32_F64 : X86::KNC_CVT_U32_F64)
+                     : (Signed ? X86::KNC_CVT_I32_F32 : X86::KNC_CVT_U32_F32);
+  SDValue Result(DAG.getMachineNode(MC, DL,
+      Wide ? MVT::v8f64 : MVT::v16f32, Carrier), 0);
+  EVT BitsVT = Wide ? MVT::v8i64 : MVT::v16i32;
+  EVT IntVT = Wide ? MVT::i64 : MVT::i32;
+  SDValue Bits = DAG.getNode(ISD::EXTRACT_VECTOR_ELT, DL, IntVT,
+      DAG.getBitcast(BitsVT, Result), DAG.getVectorIdxConstant(0, DL));
+  return DAG.getBitcast(DstVT, Bits);
+}
+
+static SDValue lowerKNCScalarFP(SDNode *N, SelectionDAG &DAG) {
+  EVT VT = N->getValueType(0);
+  if (VT != MVT::f32 && VT != MVT::f64)
+    return SDValue();
