+target triple = "x86_64-unknown-linux-gnu"
+; CHECK-LABEL: native_signed_to_double:
+; CHECK-NOT: callq
+; CHECK: knc.vcvtdq2pd
+; BEFORE-LABEL: native_signed_to_double:
