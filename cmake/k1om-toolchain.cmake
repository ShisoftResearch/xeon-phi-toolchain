set(CMAKE_SYSTEM_NAME Linux)
set(CMAKE_SYSTEM_PROCESSOR k1om)
get_filename_component(PHI_ROOT "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
set(CMAKE_C_COMPILER "${PHI_ROOT}/bin/clang-knc")
set(K1OM_MODERN_CXX OFF CACHE BOOL "Use the separately built C++17 library")
list(APPEND CMAKE_TRY_COMPILE_PLATFORM_VARIABLES K1OM_MODERN_CXX)
if(K1OM_MODERN_CXX)
  set(CMAKE_CXX_COMPILER "${PHI_ROOT}/bin/clang++-knc-modern")
else()
  set(CMAKE_CXX_COMPILER "${PHI_ROOT}/bin/clang++-knc")
endif()
if(DEFINED ENV{PHI_LLVM_BUILD})
  set(PHI_LLVM_BUILD "$ENV{PHI_LLVM_BUILD}")
else()
  set(PHI_LLVM_BUILD "${PHI_ROOT}/build/llvm")
endif()
if(DEFINED ENV{PHI_SDK_ROOT})
  set(PHI_SDK_ROOT "$ENV{PHI_SDK_ROOT}")
else()
  set(PHI_SDK_ROOT "${PHI_ROOT}/build/sdk")
endif()
set(CMAKE_AR "${PHI_LLVM_BUILD}/bin/llvm-ar")
set(CMAKE_RANLIB "${PHI_SDK_ROOT}/sysroots/x86_64-mpsssdk-linux/usr/bin/k1om-mpss-linux/k1om-mpss-linux-ranlib")
set(CMAKE_FIND_ROOT_PATH "${PHI_SDK_ROOT}/sysroots/k1om-mpss-linux")
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
