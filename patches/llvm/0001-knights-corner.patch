+static SDValue lowerKNCFPConversion(SDNode *N, SelectionDAG &DAG) {
+  EVT DstVT = N->getValueType(0);
+  SDValue Src = N->getOperand(0);
+  EVT SrcVT = Src.getValueType();
+  if (!DstVT.isFixedLengthVector() || !SrcVT.isFixedLengthVector())
+    return SDValue();
+  bool Extend = N->getOpcode() == ISD::FP_EXTEND;
+  if (SrcVT.getScalarType() != (Extend ? MVT::f32 : MVT::f64) ||
+      DstVT.getScalarType() != (Extend ? MVT::f64 : MVT::f32))
+    return SDValue();
+  SDLoc DL(N);
+  unsigned Lanes = DstVT.getVectorNumElements();
+  EVT SrcElt = Extend ? MVT::i32 : MVT::i64;
+  EVT DstElt = Extend ? MVT::i64 : MVT::i32;
+  EVT SrcBitsVT = EVT::getVectorVT(*DAG.getContext(), SrcElt, Lanes);
+  EVT DstBitsVT = EVT::getVectorVT(*DAG.getContext(), DstElt, Lanes);
+  SDValue Bits = DAG.getBitcast(SrcBitsVT, Src);
+  SmallVector<SDValue, 32> Result;
+  for (unsigned Base = 0; Base < Lanes; Base += 8) {
+    SmallVector<SDValue, 16> Input;
+    for (unsigned I = 0; I < (Extend ? 16u : 8u); ++I)
+      Input.push_back(I < 8 && Base + I < Lanes
+          ? DAG.getNode(ISD::EXTRACT_VECTOR_ELT, DL, SrcElt, Bits,
+                        DAG.getVectorIdxConstant(Base + I, DL))
+          : DAG.getUNDEF(SrcElt));
+    SDValue V = DAG.getBuildVector(Extend ? MVT::v16i32 : MVT::v8i64,
+                                  DL, Input);
+    SDValue Converted;
+    if (Extend) {
+      Converted = SDValue(DAG.getMachineNode(X86::KNC_CVT_F32_F64, DL,
+                                             MVT::v8f64, V), 0);
+      Converted = DAG.getBitcast(MVT::v8i64, Converted);
+    } else {
+      V = DAG.getBitcast(MVT::v8f64, V);
+      Converted = SDValue(DAG.getMachineNode(X86::KNC_CVT_F64_F32, DL,
+                                             MVT::v16i32, V), 0);
+    }
+    for (unsigned I = 0; I < 8 && Base + I < Lanes; ++I)
+      Result.push_back(DAG.getNode(ISD::EXTRACT_VECTOR_ELT, DL, DstElt,
+                                  Converted, DAG.getVectorIdxConstant(I, DL)));
+  }
+  return DAG.getBitcast(DstVT, DAG.getBuildVector(DstBitsVT, DL, Result));
+}
+
+// Eight low dwords convert directly to/from eight doubles. Keep the machine
+// interface in legal 512-bit types and let existing split/build combines recover
+// register chunks rather than issuing one scalar helper call per lane.
+static SDValue lowerKNCI32FP64Conversion(SDNode *N, SelectionDAG &DAG) {
+  unsigned Opcode = N->getOpcode();
+  bool ToFP = Opcode == ISD::SINT_TO_FP || Opcode == ISD::UINT_TO_FP;
+  bool FromFP = Opcode == ISD::FP_TO_SINT || Opcode == ISD::FP_TO_UINT;
+  if (!ToFP && !FromFP)
+    return SDValue();
+  EVT DstVT = N->getValueType(0), SrcVT = N->getOperand(0).getValueType();
+  if (!DstVT.isFixedLengthVector() || !SrcVT.isFixedLengthVector() ||
+      SrcVT.getVectorNumElements() != DstVT.getVectorNumElements() ||
+      SrcVT.getScalarType() != (ToFP ? MVT::i32 : MVT::f64) ||
+      DstVT.getScalarType() != (ToFP ? MVT::f64 : MVT::i32))
+    return SDValue();
+  unsigned Lanes = DstVT.getVectorNumElements();
+  if (Lanes < 2 || Lanes > 32 || !isPowerOf2_32(Lanes))
+    return SDValue();
+  unsigned MC = ToFP ? (Opcode == ISD::SINT_TO_FP ? X86::KNC_CVT_I32_F64
+                                                : X86::KNC_CVT_U32_F64)
+                     : (Opcode == ISD::FP_TO_SINT ? X86::KNC_CVT_F64_I32
+                                                 : X86::KNC_CVT_F64_U32);
+  EVT SrcElt = ToFP ? MVT::i32 : MVT::i64;
+  EVT DstElt = ToFP ? MVT::i64 : MVT::i32;
+  EVT SrcBitsVT = EVT::getVectorVT(*DAG.getContext(), SrcElt, Lanes);
+  EVT DstBitsVT = EVT::getVectorVT(*DAG.getContext(), DstElt, Lanes);
+  SDLoc DL(N);
+  SDValue Bits = DAG.getBitcast(SrcBitsVT, N->getOperand(0));
+  SmallVector<SDValue, 32> Result;
+  for (unsigned Base = 0; Base < Lanes; Base += 8) {
+    SmallVector<SDValue, 16> Input;
+    for (unsigned I = 0; I != (ToFP ? 16u : 8u); ++I)
+      Input.push_back(I < 8 && Base + I < Lanes
+          ? DAG.getNode(ISD::EXTRACT_VECTOR_ELT, DL, SrcElt, Bits,
+                        DAG.getVectorIdxConstant(Base + I, DL))
+          : DAG.getUNDEF(SrcElt));
+    SDValue V = DAG.getBuildVector(ToFP ? MVT::v16i32 : MVT::v8i64,
+                                    DL, Input);
+    if (!ToFP)
+      V = DAG.getBitcast(MVT::v8f64, V);
+    SDValue Converted(DAG.getMachineNode(MC, DL,
+        ToFP ? MVT::v8f64 : MVT::v16i32, V), 0);
+    Converted = DAG.getBitcast(ToFP ? MVT::v8i64 : MVT::v16i32, Converted);
+    for (unsigned I = 0; I < 8 && Base + I < Lanes; ++I)
+      Result.push_back(DAG.getNode(ISD::EXTRACT_VECTOR_ELT, DL, DstElt,
+          Converted, DAG.getVectorIdxConstant(I, DL)));
+  }
+  return DAG.getBitcast(DstVT, DAG.getBuildVector(DstBitsVT, DL, Result));
+}
