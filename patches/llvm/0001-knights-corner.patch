+ define float @reduce_convert_scale(<16 x i32> %x, float %scale) {
+  %sum = call i32 @llvm.vector.reduce.add.v16i32(<16 x i32> %x)
+  %f = sitofp i32 %sum to float
+  %r = fmul float %f, %scale
+  ret float %r
+}
+; NATIVE-LABEL: extract_lane7:
+; NATIVE: knc.cvt_u32_f32
+ define float @extract_lane7(<16 x i32> %x) {
+  %v = extractelement <16 x i32> %x, i32 7
+  %f = uitofp i32 %v to float
+  ret float %f
+}
+declare i32 @llvm.vector.reduce.add.v16i32(<16 x i32>)
